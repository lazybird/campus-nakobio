---
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/catalog.json';

const categories = [
  { id: 'all', label: 'Toutes les formations' },
  { id: 'Fondamentaux', label: '🌱 Fondamentaux' },
  { id: 'Légumes du potager', label: '🍅 Légumes du potager' },
  { id: 'Outils & Méthodes', label: '📋 Outils & Méthodes' }
];
---

<Layout title="Catalogue des Semences Paysannes" description="Découvrez les 36 modules de formation pratique pour apprendre à produire et conserver ses propres semences paysannes.">
  <section class="catalog-hero">
    <div class="container">
      <div class="hero-top">
        <a href="/" class="back-link">← Retour à l'accueil</a>
        <span class="badge badge-primary">36 Modules Pratiques</span>
      </div>
      <h1 class="page-title">Production de Semences Paysannes</h1>
      <p class="page-subtitle">
        Modules illustrés étape par étape pour maîtriser la récolte, le tri, la pollinisation et la conservation des semences en milieu tropical.
      </p>

      <!-- Barre de recherche et filtres -->
      <div class="search-bar-wrapper">
        <div class="search-input-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            id="course-search" 
            placeholder="Rechercher une plante, une technique (ex: tomate, carotte, pollinisation, séchage)..." 
            aria-label="Rechercher une formation"
          />
        </div>

        <div class="filter-pills" role="tablist">
          {categories.map((cat, idx) => (
            <button 
              type="button" 
              class:list={['filter-pill', { active: idx === 0 }]} 
              data-cat={cat.id}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="catalog-grid-section">
    <div class="container">
      <div class="courses-grid" id="courses-grid">
        {catalog.map((course) => (
          <article 
            class="course-card" 
            data-category={course.category} 
            data-search={`${course.title.toLowerCase()} ${course.summary?.toLowerCase() || ''} ${course.id.toLowerCase()}`}
          >
            <a href={`/semences/${course.id}`} class="card-link">
              <div class="card-media">
                <span class="card-badge">{course.category}</span>
                <img 
                  src={`/${course.cover_image}`} 
                  alt={course.title} 
                  loading="lazy" 
                  onerror="this.onerror=null; this.src='/assets/images/placeholder-seed.svg';"
                />
              </div>
              <div class="card-body">
                <span class="card-code">{course.id.split('_')[0].toUpperCase()}</span>
                <h2 class="card-title">{course.title}</h2>
                <p class="card-summary">{course.summary || 'Formation pratique sur les semences paysannes.'}</p>
                <div class="card-meta">
                  <span class="card-pages">📄 {course.total_pages} parties</span>
                  <span class="card-cta">Consulter →</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div id="no-results" class="no-results" style="display: none;">
        <p>Aucune formation ne correspond à votre recherche.</p>
        <button id="reset-filter-btn" class="btn btn-outline" style="margin-top: 1rem;">Réinitialiser</button>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupSearchAndFilters() {
    const searchInput = document.getElementById('course-search') as HTMLInputElement | null;
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.course-card');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-filter-btn');

    let currentCategory = 'all';

    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const searchTarget = card.getAttribute('data-search') || '';

        const matchCat = currentCategory === 'all' || cat === currentCategory;
        const matchQuery = !query || searchTarget.includes(query);

        if (matchCat && matchQuery) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        currentCategory = pill.getAttribute('data-cat') || 'all';
        applyFilters();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentCategory = 'all';
      filterPills.forEach((p) => {
        p.classList.toggle('active', p.getAttribute('data-cat') === 'all');
      });
      applyFilters();
    });
  }

  // Initialisation dès chargement
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSearchAndFilters);
  } else {
    setupSearchAndFilters();
  }
</script>

<style>
  .catalog-hero {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 2.5rem 0 2rem;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .back-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .back-link:hover {
    color: var(--color-primary-deep);
  }

  .page-title {
    font-size: 2.1rem;
    font-weight: 800;
    color: var(--color-primary-deep);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    max-width: 720px;
    margin-bottom: 2rem;
  }

  .search-bar-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-input-box {
    position: relative;
    max-width: 600px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input-box input {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.8rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-family: inherit;
    font-size: 0.95rem;
    background: #ffffff;
    color: var(--color-text);
    outline: none;
    transition: border-color 0.15s ease;
  }

  .search-input-box input:focus {
    border-color: var(--color-primary);
  }

  .filter-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    background: #f1f3f0;
    border: 1px solid var(--color-border);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-pill:hover {
    background: var(--color-primary-light);
    color: var(--color-primary-deep);
    border-color: var(--color-primary-border);
  }

  .filter-pill.active {
    background: var(--color-primary-deep);
    color: #ffffff;
    border-color: var(--color-primary-deep);
  }

  .catalog-grid-section {
    padding: 2.5rem 0 4rem;
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .course-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .course-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-hover);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-media {
    position: relative;
    height: 170px;
    background-color: #f4f1ea;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(255, 255, 255, 0.92);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-primary-deep);
    border: 1px solid var(--color-border);
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-code {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-primary);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary-deep);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .card-summary {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 0.85rem;
    font-size: 0.85rem;
  }

  .card-pages {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .card-cta {
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .no-results {
    text-align: center;
    padding: 4rem 1rem;
    background: #ffffff;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
</style>
