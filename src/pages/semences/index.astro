---
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/catalog.json';

const categories = [
  { id: 'all', label: 'Toutes les formations' },
  { id: 'Fondamentaux', label: '🌱 Fondamentaux' },
  { id: 'Fiches légumes', label: '🍅 Fiches légumes' }
];
---

<Layout title="Catalogue des Semences Paysannes" description="Découvrez les 34 modules de formation pratique pour apprendre à produire et conserver ses propres semences paysannes.">
  <section class="catalog-hero">
    <div class="container">
      <div class="hero-top">
        <a href="/" class="back-link">← Retour au campus</a>
        <div class="hero-badges">
          <span class="badge badge-accent">
            <span class="badge-dot"></span>
            34 Modules Pratiques
          </span>
          <span class="badge badge-bio">
            <span class="badge-dot"></span>
            100% Reproductible
          </span>
        </div>
      </div>
      <h1 class="page-title scroll-reveal">Production de Semences Paysannes</h1>
      <p class="page-subtitle scroll-reveal delay-1">
        Modules illustrés étape par étape pour maîtriser la récolte, le tri, la pollinisation et la conservation hermétique des semences en climat tropical et sahélien.
      </p>

      <!-- Barre de recherche et filtres -->
      <div class="search-bar-wrapper scroll-reveal delay-2">
        <div class="search-input-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            id="course-search" 
            placeholder="Rechercher une plante, une technique (ex: tomate, carotte, pollinisation, séchage)..." 
            aria-label="Rechercher une formation"
          />
        </div>

        <div class="filter-pills" role="tablist">
          {categories.map((cat, idx) => (
            <button 
              type="button" 
              class:list={['filter-pill', { active: idx === 0 }]} 
              data-cat={cat.id}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="catalog-grid-section">
    <div class="container">
      <div class="courses-grid" id="courses-grid">
        {catalog.map((course) => (
          <article 
            class="course-card card card-interactive scroll-reveal" 
            data-category={course.category} 
            data-search={`${course.title.toLowerCase()} ${course.summary?.toLowerCase() || ''} ${course.id.toLowerCase()}`}
          >
            <a href={`/semences/${course.id}`} class="card-link">
              <div class="card-media">
                <span class="card-badge badge badge-brand">{course.category}</span>
                <img 
                  src={`/${course.cover_image}`} 
                  alt={course.title} 
                  loading="lazy" 
                  onerror="this.onerror=null; this.src='/assets/images/placeholder-seed.svg';"
                />
              </div>
              <div class="card-body">
                <div class="card-top-meta">
                  <span class="card-code">{course.id.split('_')[0].toUpperCase()}</span>
                  <span class="card-pages">📄 {course.total_pages} étapes</span>
                </div>
                <h2 class="card-title">{course.title}</h2>
                <p class="card-summary">{course.summary || 'Formation pratique sur les semences paysannes.'}</p>
                <div class="card-meta">
                  <span class="card-tag">Agroécologie</span>
                  <span class="card-cta">Consulter le cours →</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div id="no-results" class="no-results" style="display: none;">
        <p>Aucune formation ne correspond à votre recherche.</p>
        <button id="reset-filter-btn" class="btn btn-secondary" style="margin-top: 1rem;">Réinitialiser les filtres</button>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupSearchAndFilters() {
    const searchInput = document.getElementById('course-search') as HTMLInputElement | null;
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.course-card');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-filter-btn');

    let currentCategory = 'all';

    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const searchTarget = card.getAttribute('data-search') || '';

        const matchCat = currentCategory === 'all' || cat === currentCategory;
        const matchQuery = !query || searchTarget.includes(query);

        if (matchCat && matchQuery) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        currentCategory = pill.getAttribute('data-cat') || 'all';
        applyFilters();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      filterPills.forEach((p, idx) => {
        if (idx === 0) p.classList.add('active');
        else p.classList.remove('active');
      });
      currentCategory = 'all';
      applyFilters();
    });
  }

  // Initialisation dès chargement
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSearchAndFilters);
  } else {
    setupSearchAndFilters();
  }
</script>

<style>
  .catalog-hero {
    background: linear-gradient(180deg, #FFFDF6 0%, #F5EED8 100%);
    border-bottom: 1px solid var(--color-border);
    padding: 3.5rem 0 2.5rem;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-badges {
    display: flex;
    gap: 0.5rem;
  }

  .back-link {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .back-link:hover {
    color: var(--color-brand-secondary);
    transform: translateX(-2px);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: 0.65rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .page-subtitle {
    font-family: var(--font-sans);
    color: var(--color-ink-soft);
    font-size: 1.08rem;
    max-width: 780px;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .search-bar-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-input-box {
    position: relative;
    max-width: 640px;
  }

  .search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-ink-faint);
    pointer-events: none;
  }

  .search-input-box input {
    width: 100%;
    min-height: 48px;
    padding: 0.85rem 1.2rem 0.85rem 3rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: 1rem;
    background: #ffffff;
    color: var(--color-ink);
    outline: none;
    box-shadow: var(--shadow-sm);
    touch-action: manipulation;
    -webkit-appearance: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .search-input-box input:focus {
    border-color: var(--color-brand-primary);
    box-shadow: 0 0 0 3px rgba(47, 74, 52, 0.12);
  }

  .filter-pills {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .filter-pills {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.4rem;
      margin: 0 -1rem;
      padding-left: 1rem;
      padding-right: 1rem;
      scrollbar-width: none;
    }
    .filter-pills::-webkit-scrollbar {
      display: none;
    }
    .filter-pill {
      white-space: nowrap;
      flex-shrink: 0;
    }
  }

  .filter-pill {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--color-border);
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: all var(--transition-base);
  }

  .filter-pill:hover {
    background: var(--color-surface-sunken);
    color: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
  }

  .filter-pill.active {
    background: var(--color-brand-primary);
    color: #ffffff;
    border-color: var(--color-brand-primary);
    box-shadow: var(--shadow-sm);
  }


  .catalog-grid-section {
    padding: 3.5rem 0 5rem;
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 2rem;
  }

  .course-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--color-surface-card);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card-media {
    position: relative;
    height: 180px;
    background-color: var(--color-surface-sunken);
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .course-card:hover .card-media img {
    transform: scale(1.06);
  }

  .card-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .card-code {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-brand-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-pages {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--color-ink-faint);
    font-weight: 500;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: 0.65rem;
    line-height: 1.3;
  }

  .card-summary {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    font-size: 0.85rem;
  }

  .card-tag {
    color: var(--color-ink-faint);
    font-weight: 500;
  }

  .card-cta {
    font-weight: 700;
    color: var(--color-brand-secondary);
    transition: transform var(--transition-fast);
  }

  .course-card:hover .card-cta {
    transform: translateX(3px);
  }

  .no-results {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--color-surface-sunken);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    font-family: var(--font-sans);
    color: var(--color-ink-soft);
  }
</style>
