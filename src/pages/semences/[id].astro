    color: var(--color-ink-faint);
    font-weight: 500;
  }

  .toc-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
    max-height: 240px;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .toc-step-chip {
