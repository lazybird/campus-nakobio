---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dataDir = path.resolve('./src/data');
  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json') && f !== 'catalog.json');

  return files.map(file => {
    const filePath = path.join(dataDir, file);
    const content = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
    const id = file.replace('.json', '');
    return {
      params: { id },
      props: { course: content }
    };
  });
}

const { course } = Astro.props;

// Fonction de formatage du texte pédagogique (gras, listes, alertes)
function formatPedagogicalText(rawText: string) {
  if (!rawText) return '<p><em>Contenu technique en cours de finalisation</em></p>';

  let html = rawText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  const lines = html.split('\n');
  let inList = false;
  let listType = 'ul';
  let formattedLines: string[] = [];

  for (let line of lines) {
    line = line.trim();
    if (!line) continue;

    if (line.startsWith('⚠️') || line.toLowerCase().startsWith('attention')) {
      if (inList) { formattedLines.push(`</${listType}>`); inList = false; }
      formattedLines.push(`<div class="slide-alert">${line}</div>`);
      continue;
    }

    const numMatch = line.match(/^(\d+)\.\s+(.*)/);
    if (numMatch) {
      if (!inList || listType !== 'ol') {
        if (inList) formattedLines.push(`</${listType}>`);
        formattedLines.push('<ol>');
        inList = true;
        listType = 'ol';
      }
      formattedLines.push(`<li>${numMatch[2]}</li>`);
      continue;
    }

    const bulletMatch = line.match(/^[-•]\s+(.*)/);
    if (bulletMatch) {
      if (!inList || listType !== 'ul') {
        if (inList) formattedLines.push(`</${listType}>`);
        formattedLines.push('<ul>');
        inList = true;
        listType = 'ul';
      }
      formattedLines.push(`<li>${bulletMatch[1]}</li>`);
      continue;
    }

    if (inList) {
      formattedLines.push(`</${listType}>`);
      inList = false;
    }
    formattedLines.push(`<p>${line}</p>`);
  }

  if (inList) {
    formattedLines.push(`</${listType}>`);
  }

  return formattedLines.join('');
}

const pagesList = course.pages || [];
---

<Layout title={course.title} description={course.summary || "Module de formation pratique sur les semences paysannes."}>
  <!-- En-tête fixe avec bouton retour et déclencheur d'impression PDF -->
  <div class="lesson-topbar no-print">
    <div class="container lesson-topbar-inner">
      <a href="/semences" class="btn btn-outline back-btn" title="Retourner au catalogue des formations">
        ← Catalogue
      </a>
      <div class="lesson-title-meta">
        <span class="badge badge-primary">{course.category || 'Semences Paysannes'}</span>
        <h1 class="lesson-header-title">{course.title}</h1>
      </div>
      <div class="lesson-actions">
        <button type="button" class="btn btn-primary" id="btn-print-lesson" title="Télécharger ou imprimer ce cours en PDF">
          🖨️ Version PDF
        </button>
      </div>
    </div>
    <div class="scroll-progress-container" aria-hidden="true">
      <div class="scroll-progress-bar" id="scroll-progress"></div>
    </div>
  </div>

  <div class="container lesson-container">
    <!-- Hero d'introduction du module -->
    <header class="lesson-hero">
      <div class="lesson-badge-row">
        <span class="badge badge-primary">🌱 {course.category || 'Semences Paysannes'}</span>
        <span class="badge badge-neutral">📖 {course.total_pages || pagesList.length} parties</span>
        <span class="badge badge-neutral">☀️ Terroir tropical &amp; sahélien</span>
      </div>
      <h2 class="hero-course-title">{course.title}</h2>
      {course.summary && <p class="hero-course-summary">{course.summary}</p>}

      <!-- Sommaire dépliable -->
      {pagesList.length > 0 && (
        <details class="lesson-quick-toc no-print">
          <summary class="toc-summary-toggle">
            <span class="toc-summary-label">
              📋 Sommaire des chapitres ({pagesList.length} parties)
            </span>
            <span class="toc-toggle-hint">Afficher / Masquer</span>
          </summary>
          <div class="toc-pills-list">
            {pagesList.map((p: any) => (
              <a href={`#partie-${p.page_number}`} class="toc-step-chip">
                <span class="toc-num">{p.page_number}</span>
                <span class="toc-title">{p.title}</span>
              </a>
            ))}
          </div>
        </details>
      )}
    </header>

    <!-- Séquence des fiches / parties du cours -->
    <div class="slides-flow">
      {pagesList.map((page: any, idx: number) => {
        const hasImage = page.image && page.image.length > 0;
        const formattedHtml = formatPedagogicalText(page.text);
        const nextPage = pagesList[idx + 1];

        return (
          <article class="slide-unit" id={`partie-${page.page_number}`}>
            <!-- En-tête d'étape -->
            <div class="slide-step-header-bar">
              <div class="step-badge-circle">
                <span class="step-badge-num">{page.page_number}</span>
              </div>
              <div class="step-badge-meta">
                <span class="step-meta-label">PARTIE {page.page_number} SUR {course.total_pages || pagesList.length}</span>
                <span class="step-meta-name">{page.title}</span>
              </div>
            </div>

            <!-- Zone Visuelle : Image du cours ou carnet de croquis pédagogique -->
            <div class="slide-visual-wrapper">
              {hasImage ? (
                <img 
                  src={`/${page.image}`} 
                  alt={page.title} 
                  loading={idx < 2 ? "eager" : "lazy"}
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
              ) : null}

              <div 
                class="sketch-placeholder-container" 
                style={hasImage ? "display: none;" : "display: flex;"}
              >
                <div class="sketch-board-frame">
                  <div class="sketch-frame-top">
                    <span class="sketch-type-badge">
                      🎨 Croquis Pédagogique en Préparation
                    </span>
                    <span class="sketch-format-tag">Format 16:9 • Planche Terrain</span>
                  </div>

                  <div class="sketch-desc-body">
                    <div class="sketch-desc-title">Descriptif technique de l'illustration :</div>
                    <blockquote class="sketch-desc-text">
                      « {page.illustration_description || 'Dessin technique de terrain illustrant les gestes clés et observations pratiques de cette étape.'} »
                    </blockquote>
                  </div>

                  <div class="sketch-frame-bottom">
                    <span class="sketch-author-note">
                      Illustration en cours de réalisation par l'équipe graphique
                    </span>
                    <span class="sketch-brand-watermark">NAKÔBIO ACADÉMIE</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Fiche texte pédagogique sous l'image -->
            <div class="slide-body-text">
              <h3 class="slide-step-title">{page.title}</h3>
              <div class="slide-pedagogical-content" set:html={formattedHtml} />
            </div>

            <!-- Séparateur vers l'étape suivante -->
            {nextPage && (
              <div class="pedagogical-step-divider no-print">
                <div class="divider-line"></div>
                <a href={`#partie-${nextPage.page_number}`} class="divider-milestone-link">
                  <span class="milestone-next-label">
                    Partie suivante : <strong>{nextPage.page_number}. {nextPage.title}</strong>
                  </span>
                  <span class="milestone-action-arrow" aria-hidden="true">➔</span>
                </a>
                <div class="divider-line"></div>
              </div>
            )}
          </article>
        );
      })}
    </div>

    <!-- Écran de fin de cours -->
    <div class="lesson-footer-completion no-print">
      <div class="completion-icon">🌾</div>
      <h3 class="completion-title">Formation complétée avec succès !</h3>
      <p class="completion-desc">
        Vous avez parcouru l'ensemble des {course.total_pages || pagesList.length} parties de « {course.title} ». 
        Vous pouvez télécharger ce support au format PDF pour vos interventions au champ ou explorer un autre module.
      </p>
      <div class="completion-actions">
        <a href="/semences" class="btn btn-primary">Retour au catalogue</a>
        <button type="button" class="btn btn-outline" onclick="window.print()">
          Imprimer la version PDF
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Gestion impression
  document.getElementById('btn-print-lesson')?.addEventListener('click', () => {
    window.print();
  });

  // Barre de défilement dynamique
  window.addEventListener('scroll', () => {
    const progressBar = document.getElementById('scroll-progress');
    if (!progressBar) return;
    const winScroll = document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
    progressBar.style.width = scrolled + '%';
  });
</script>

<style>
  .lesson-topbar {
    position: sticky;
    top: 70px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    z-index: 90;
    box-shadow: var(--shadow-sm);
  }

  .lesson-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 1rem;
  }

  .lesson-title-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
    white-space: nowrap;
  }

  .lesson-header-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-deep);
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .scroll-progress-container {
    width: 100%;
    height: 3px;
    background: transparent;
  }

  .scroll-progress-bar {
    height: 100%;
    background: var(--color-primary);
    width: 0%;
    transition: width 0.1s ease;
  }

  .lesson-container {
    max-width: 920px;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  /* Hero Intro */
  .lesson-hero {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.25rem 2rem;
    margin-bottom: 2.5rem;
    border-left: 6px solid var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .lesson-badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .hero-course-title {
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    font-weight: 800;
    color: var(--color-primary-deep);
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .hero-course-summary {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  /* Sommaire */
  .lesson-quick-toc {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    margin-top: 0.5rem;
  }

  .toc-summary-toggle {
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-primary-deep);
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
  }

  .toc-toggle-hint {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .toc-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
    max-height: 240px;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .toc-step-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    color: var(--color-text);
    transition: all 0.15s ease;
  }

  .toc-step-chip:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
    color: var(--color-primary-deep);
  }

  .toc-num {
    font-weight: 800;
    color: var(--color-primary);
  }

  /* Séquence des Fiches */
  .slides-flow {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .slide-unit {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .slide-step-header-bar {
    display: flex;
    align-items: center;
    background: #fbf9f5;
    border-bottom: 1.5px solid var(--color-border);
    padding: 0.85rem 1.5rem;
    gap: 1rem;
  }

  .step-badge-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-primary-deep);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .step-badge-meta {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .step-meta-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--color-primary-dark);
    text-transform: uppercase;
  }

  .step-meta-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-deep);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Zone Image 16:9 */
  .slide-visual-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #ede6d8;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide-visual-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Carnet de croquis pour illustrations en attente */
  .sketch-placeholder-container {
    width: 100%;
    height: 100%;
    padding: 1.5rem 2rem;
    background: #fbf7ee;
    background-image: radial-gradient(#e4dac8 1px, transparent 1px);
    background-size: 18px 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sketch-board-frame {
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.9);
    border: 2px dashed #bcaa8c;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .sketch-frame-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ebdcc5;
    padding-bottom: 0.6rem;
  }

  .sketch-type-badge {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-primary-deep);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sketch-format-tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .sketch-desc-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-earth);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .sketch-desc-text {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.55;
    color: #2b3324;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sketch-frame-bottom {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border-top: 1px dashed #ebdcc5;
    padding-top: 0.5rem;
    font-weight: 600;
  }

  .sketch-brand-watermark {
    font-weight: 800;
    color: var(--color-primary);
  }

  /* Corps de texte sous l'image */
  .slide-body-text {
    padding: 2rem 2rem 2.25rem;
    background: #ffffff;
    border-top: 3px solid var(--color-primary);
  }

  .slide-step-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-primary-deep);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .slide-pedagogical-content {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .slide-pedagogical-content :global(p) {
    margin-bottom: 1rem;
  }

  .slide-pedagogical-content :global(ol),
  .slide-pedagogical-content :global(ul) {
    margin: 0.75rem 0 1rem 1.5rem;
  }

  .slide-pedagogical-content :global(li) {
    margin-bottom: 0.45rem;
  }

  .slide-pedagogical-content :global(strong) {
    color: var(--color-primary-deep);
    font-weight: 700;
  }

  .slide-pedagogical-content :global(.slide-alert) {
    background: var(--color-earth-light);
    border-left: 4px solid var(--color-earth);
    padding: 0.9rem 1.25rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: 1.15rem 0;
    font-size: 0.98rem;
    color: var(--color-earth);
    font-weight: 600;
  }

  /* Séparateur entre étapes */
  .pedagogical-step-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: #fbf9f5;
    border-top: 1px solid var(--color-border);
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .divider-milestone-link {
    font-size: 0.88rem;
    color: var(--color-primary-deep);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .divider-milestone-link:hover {
    color: var(--color-primary);
  }

  /* Écran de fin */
  .lesson-footer-completion {
    text-align: center;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 3rem 2rem;
    margin-top: 3.5rem;
    box-shadow: var(--shadow-sm);
  }

  .completion-icon {
    font-size: 2.75rem;
    margin-bottom: 0.6rem;
  }

  .completion-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary-deep);
    margin-bottom: 0.5rem;
  }

  .completion-desc {
    color: var(--color-text-secondary);
    max-width: 580px;
    margin: 0 auto 1.75rem;
    line-height: 1.6;
  }

  .completion-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Optimisation impression papier et PDF */
  @media print {
    .no-print {
      display: none !important;
    }
    body {
      background: white !important;
      color: black !important;
    }
    .lesson-container {
      max-width: 100% !important;
      padding: 0 !important;
    }
    .slide-unit {
      break-inside: avoid;
      page-break-inside: avoid;
      margin-bottom: 2.5rem;
      border: 1px solid #ddd !important;
      box-shadow: none !important;
    }
    .slide-visual-wrapper {
      max-height: 380px;
    }
  }

  @media (max-width: 640px) {
    .lesson-topbar-inner {
      flex-wrap: wrap;
      height: auto;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
    .lesson-title-meta {
      order: 3;
      width: 100%;
    }
  }
</style>
