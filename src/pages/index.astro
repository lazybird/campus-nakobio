---
import Layout from '../layouts/Layout.astro';
import semencesCatalog from '../data/catalog.json';
import maraichageCatalog from '../data/maraichage/catalog.json';

const maraichageCount = maraichageCatalog.length;
const semencesCount = semencesCatalog.length;
const totalModules = maraichageCount + semencesCount;

const semencesFondamentaux = semencesCatalog.filter(c => c.category === 'Fondamentaux').length;
const semencesLegumes = semencesCatalog.filter(c => c.category === 'Fiches légumes').length;

const starterMaraichageIds = [
  '101_fondamentaux_maraichage_sol_vivant',
  '201_sols_vivants',
  '301_realiser_les_planches_de_cultures'
];
const starterMaraichage = starterMaraichageIds
  .map(id => maraichageCatalog.find(c => c.id === id))
  .filter((c): c is (typeof maraichageCatalog)[number] => Boolean(c));

const starterSemencesIds = [
  'a1_cest_quoi_une_graine',
  'a4_la_pollinisation',
  'a7_extraction_sechage_tri_et_conservation'
];
const starterSemences = starterSemencesIds
  .map(id => semencesCatalog.find(c => c.id === id))
  .filter((c): c is (typeof semencesCatalog)[number] => Boolean(c));
---

<Layout
  title="Formations & Savoirs Agroécologiques"
  description={`Campus Nakôbio : ${totalModules} modules gratuits et fiches imprimables en maraîchage bio-intensif en sol vivant et production de semences paysannes.`}
>
  <!-- HERO ÉDITORIAL ASYMÉTRIQUE -->
  <section class="hero-editorial">
    <div class="container hero-grid">
      <div class="hero-body">
        <p class="hero-eyebrow">Campus Nakôbio • Ressources libres d'agroécologie</p>

        <h1 class="hero-title">
          Maraîchage en sol vivant &amp; semences paysannes
        </h1>

        <p class="hero-lead">
          Apprenez pas à pas à nourrir la terre, économiser l'eau, protéger vos cultures naturellement et reproduire vos propres semences. Des cours gratuits, illustrés et directement applicables au champ comme au jardin.
        </p>

        <div class="hero-actions">
          <a href="/maraichage" class="btn btn-accent btn-lg">
            Cours Maraîchage ({maraichageCount}) →
          </a>
          <a href="/semences" class="btn btn-accent btn-lg">
            Cours Semences ({semencesCount}) →
          </a>
        </div>

        <p class="hero-meta">
          <span>{totalModules} modules illustrés</span>
          <span aria-hidden="true">·</span>
          <span>Accès libre sans inscription</span>
          <span aria-hidden="true">·</span>
          <span>Ressources Nakôbio &amp; Dala Seeds</span>
        </p>
      </div>

      <a
        href="https://www.youtube.com/@nakobio"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-video-card"
        aria-label="Découvrir la chaîne YouTube @nakobio (nouvel onglet)"
      >
        <div class="hero-video-thumb-wrap">
          <img
            src="/assets/images/photos/youtube-nakobio-preview.jpg"
            alt="Démonstrations terrain Nakôbio : semences paysannes et maraîchage en sol vivant"
            class="hero-video-thumb"
            width="640"
            height="360"
            loading="eager"
            decoding="async"
          />
          <span class="hero-video-badge">
            <svg class="youtube-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/>
            </svg>
            @nakobio
          </span>
          <span class="hero-video-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M8 5.14v14l11-7-11-7z"/>
            </svg>
          </span>
        </div>
        <div class="hero-video-caption">
          <div class="hero-video-caption-text">
            <strong>La chaîne YouTube Nakôbio</strong>
            <span>Retrouvez l'ensemble des cours en vidéo.</span>
          </div>
          <span class="hero-video-arrow" aria-hidden="true">↗</span>
        </div>
      </a>
    </div>
  </section>

  <!-- LES 3 CURSUS DU CAMPUS -->
  <section class="tracks-section" id="parcours">
    <div class="container">
      <header class="section-header">
        <p class="section-eyebrow">Les formations</p>
        <h2 class="section-title">Trois cursus complémentaires</h2>
        <p class="section-subtitle">
          Deux parcours complets déjà accessibles en ligne, et un troisième dédié aux outils d'observation au champ en cours de préparation.
        </p>
      </header>

      <div class="tracks-grid">
        <!-- CURSUS 1 : MARAÎCHAGE SOL VIVANT -->
        <article class="track-card">
          <div class="track-image-wrap">
            <img
              src="/assets/images/photos/track-maraichage.jpg"
              alt="Maraîchage en sol vivant et planches permanentes"
              class="track-image"
              loading="lazy"
            />
            <span class="track-status badge badge-bio">Disponible • {maraichageCount} cours</span>
          </div>

          <div class="track-content">
            <span class="track-category">Agronomie &amp; Sol Vivant</span>
            <h3 class="track-title">Maraîchage Bio-Intensif en Sol Vivant</h3>
            <p class="track-desc">
              Mettre en place des planches permanentes sans labour profond, nourrir la vie du sol et économiser l'eau en climat chaud.
            </p>

            <ul class="track-features">
              <li>Fondements du sol vivant, compostage et paillage</li>
              <li>Planches permanentes (75 cm) et pépinières protégées</li>
              <li>Gestion de l'eau et systèmes d'irrigation adaptés</li>
              <li>Prévention et traitements biologiques des cultures</li>
            </ul>

            <div class="track-footer">
              <a href="/maraichage" class="btn btn-accent track-btn">
                Ouvrir le cursus maraîchage ({maraichageCount}) →
              </a>
            </div>
          </div>
        </article>

        <!-- CURSUS 2 : SEMENCES PAYSANNES -->
        <article class="track-card">
          <div class="track-image-wrap">
            <img
              src="/assets/images/photos/track-semences.jpg"
              alt="Atelier semences paysannes et tri de graines"
              class="track-image"
              loading="lazy"
            />
            <span class="track-status badge badge-bio">Disponible • {semencesCount} cours</span>
          </div>

          <div class="track-content">
            <span class="track-category">Autonomie Semencière</span>
            <h3 class="track-title">Production de Semences Paysannes</h3>
            <p class="track-desc">
              Sélectionner ses porte-graines, éviter les croisements indésirables, extraire, sécher et conserver ses graines d'une saison à l'autre.
            </p>

            <ul class="track-features">
              <li>{semencesFondamentaux} modules fondamentaux : pollinisation, sélection, isolement</li>
              <li>{semencesLegumes} fiches par espèce : tomate, oignon, gombo, piment, niébé…</li>
              <li>Séchage en climat chaud, tri au vent et stockage hermétique</li>
              <li>Plusieurs modules traduits (bambara, N'Ko, anglais, allemand)</li>
            </ul>

            <div class="track-footer">
              <a href="/semences" class="btn btn-accent track-btn">
                Ouvrir le cursus semences ({semencesCount}) →
              </a>
            </div>
          </div>
        </article>

        <!-- CURSUS 3 : PRATIQUES DE TERRAIN -->
        <article class="track-card track-card-upcoming">
          <div class="track-image-wrap">
            <img
              src="/assets/images/photos/track-terrain.jpg"
              alt="Pratiques de terrain, pesées et mesures simples"
              class="track-image"
              loading="lazy"
            />
            <span class="track-status badge badge-neutral">En préparation</span>
          </div>

          <div class="track-content">
            <span class="track-category">Observation &amp; Suivi</span>
            <h3 class="track-title">Pratiques de Terrain &amp; Outils Techniques</h3>
            <p class="track-desc">
              Les gestes simples d'observation, de mesure et de diagnostic pour suivre ses parcelles et échanger à distance avec un agronome.
            </p>

            <ul class="track-features">
              <li>Prendre des photos utiles au smartphone (macro, symptômes)</li>
              <li>Mesures de calibres, pesées et Poids de Mille Grains (PMG)</li>
              <li>Tests de germination avec matériel local (sable, chiffon)</li>
              <li>Grilles de relevé et carnets de suivi de parcelle</li>
            </ul>

            <div class="track-footer">
              <a href="/pratiques-terrain" class="btn btn-outline track-btn">
                Voir le programme prévu →
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ACCÈS RAPIDE : PAR OÙ COMMENCER ? -->
  <section class="quickstart-section">
    <div class="container">
      <header class="section-header">
        <p class="section-eyebrow">Accès direct</p>
        <h2 class="section-title">Par où commencer ?</h2>
        <p class="section-subtitle">
          Six fiches de base pour entrer directement dans la pratique ou préparer une première séance d'atelier.
        </p>
      </header>

      <div class="quickstart-grid">
        <div class="quickstart-col">
          <div class="quickstart-col-head">
            <h3 class="quickstart-col-title">Bases du maraîchage</h3>
            <a href="/maraichage" class="quickstart-all-link">Tout voir ({maraichageCount}) →</a>
          </div>
          <ul class="quickstart-list">
            {starterMaraichage.map(course => (
              <li>
                <a href={`/maraichage/${course.id}`} class="quickstart-item">
                  <span class="quickstart-cat">{course.category}</span>
                  <span class="quickstart-name">{course.title}</span>
                  <span class="quickstart-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="quickstart-col">
          <div class="quickstart-col-head">
            <h3 class="quickstart-col-title">Bases des semences</h3>
            <a href="/semences" class="quickstart-all-link">Tout voir ({semencesCount}) →</a>
          </div>
          <ul class="quickstart-list">
            {starterSemences.map(course => (
              <li>
                <a href={`/semences/${course.id}`} class="quickstart-item">
                  <span class="quickstart-cat">{course.category}</span>
                  <span class="quickstart-name">{course.title}</span>
                  <span class="quickstart-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- UN OUTIL CONÇU POUR LE TERRAIN -->
  <section class="usage-section">
    <div class="container">
      <div class="usage-box">
        <header class="usage-header">
          <p class="section-eyebrow">Mode d'emploi</p>
          <h2 class="usage-title">Un outil conçu pour le terrain, les ateliers et le partage</h2>
        </header>

        <div class="usage-grid">
          <div class="usage-item">
            <h3 class="usage-item-title">Au champ, sur téléphone</h3>
            <p class="usage-item-text">
              Pages légères, étapes courtes et illustrations pas-à-pas. Chaque protocole privilégie le matériel disponible localement : calebasses, tamis, sable de rivière, paillage et outils manuels.
            </p>
          </div>

          <div class="usage-item">
            <h3 class="usage-item-title">En atelier, pour les formateurs</h3>
            <p class="usage-item-text">
              Chaque cours dispose d'une mise en page dédiée à l'impression A4 pour être distribué aux groupements maraîchers et coopératives. Certains modules existent aussi en bambara, N'Ko, anglais et allemand.
            </p>
          </div>

          <div class="usage-item">
            <h3 class="usage-item-title">La démarche Nakôbio</h3>
            <p class="usage-item-text">
              Ces ressources sont publiées en accès libre et sans compte obligatoire. Elles capitalisent les formations et essais menés sur notre ferme-école au Mali, en lien avec l'association Dala Seeds, pour renforcer l'autonomie des maraîchers.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ==========================================================================
     HERO ÉDITORIAL ASYMÉTRIQUE
     ========================================================================== */
  .hero-editorial {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 3.75rem 0 4rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 3rem;
    align-items: center;
  }

  .hero-eyebrow,
  .section-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-secondary);
    margin-bottom: 0.85rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 4.2vw, 3.15rem);
    font-weight: 700;
    color: var(--color-brand-primary);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .hero-lead {
    font-family: var(--font-sans);
    font-size: 1.08rem;
    color: var(--color-ink-soft);
    line-height: 1.65;
    max-width: 58ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }

  .hero-video-card {
    display: block;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  }

  .hero-video-card:hover {
    border-color: var(--color-brand-secondary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .hero-video-thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-surface-sunken);
  }

  .hero-video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .hero-video-card:hover .hero-video-thumb {
    transform: scale(1.03);
  }

  .hero-video-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.7rem;
    border-radius: var(--radius-full, 9999px);
    background: rgba(27, 35, 24, 0.82);
    color: #FFFDF6;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero-video-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 58px;
    height: 58px;
    border-radius: var(--radius-full, 9999px);
    background: rgba(200, 104, 50, 0.94);
    color: #FFFDF6;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
    transition: transform var(--transition-base), background-color var(--transition-base);
  }

  .hero-video-card:hover .hero-video-play {
    transform: scale(1.07);
    background: var(--color-brand-primary);
  }

  .hero-video-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-top: 1px solid var(--color-border);
  }

  .hero-video-caption-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hero-video-caption-text strong {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-brand-primary);
  }

  .hero-video-caption-text span {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    color: var(--color-ink-soft);
    line-height: 1.45;
  }

  .hero-video-arrow {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-brand-secondary);
    flex-shrink: 0;
  }

  .youtube-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  /* ==========================================================================
     EN-TÊTES DE SECTIONS (ALIGNÉS À GAUCHE, SOBRE)
     ========================================================================== */
  .section-header {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.15rem);
    font-weight: 700;
    color: var(--color-brand-primary);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 0.65rem;
  }

  .section-subtitle {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  /* ==========================================================================
     LES 3 CURSUS
     ========================================================================== */
  .tracks-section {
    padding: 4.25rem 0;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    align-items: stretch;
  }

  .track-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .track-card:hover {
    border-color: var(--color-brand-primary);
    box-shadow: var(--shadow-lg);
  }

  .track-card-upcoming {
    background: var(--color-surface);
  }

  .track-image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-surface-sunken);
    border-bottom: 1px solid var(--color-border);
  }

  .track-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track-status {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
  }

  .track-content {
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .track-category {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-brand-secondary);
    margin-bottom: 0.4rem;
  }

  .track-title {
    font-family: var(--font-serif);
    font-size: 1.38rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .track-desc {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .track-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.87rem;
    color: var(--color-ink-soft);
    margin-bottom: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .track-features li {
    position: relative;
    padding-left: 1rem;
    line-height: 1.45;
  }

  .track-features li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-brand-secondary);
    font-weight: 700;
  }

  .track-footer {
    margin-top: auto;
  }

  .track-btn {
    width: 100%;
    text-align: center;
  }

  /* ==========================================================================
     ACCÈS RAPIDE : PAR OÙ COMMENCER ?
     ========================================================================== */
  .quickstart-section {
    background-color: var(--color-surface-sunken);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 4rem 0;
  }

  .quickstart-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem;
  }

  .quickstart-col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-brand-primary);
  }

  .quickstart-col-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-brand-primary);
  }

  .quickstart-all-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-brand-secondary);
  }

  .quickstart-all-link:hover {
    text-decoration: underline;
  }

  .quickstart-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .quickstart-item {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    row-gap: 0.15rem;
    align-items: center;
    padding: 1rem 1.15rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 0.5rem);
    transition: border-color var(--transition-base), background-color var(--transition-base);
  }

  .quickstart-item:hover {
    border-color: var(--color-brand-secondary);
    background: var(--color-surface);
  }

  .quickstart-cat {
    grid-column: 1;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-faint);
  }

  .quickstart-name {
    grid-column: 1;
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-brand-primary);
    line-height: 1.35;
  }

  .quickstart-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: 1.1rem;
    color: var(--color-brand-secondary);
  }

