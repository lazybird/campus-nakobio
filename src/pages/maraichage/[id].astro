---
import Layout from '../../layouts/Layout.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import fs from 'node:fs';
import path from 'node:path';
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from '../../utils/languages';
import { getAvailableTranslations } from '../../utils/courseTranslations';

export async function getStaticPaths() {
  const dataDir = path.resolve('./src/data/maraichage');
  const allJsonFiles = fs.readdirSync(dataDir).filter(f => f.endsWith('.json') && f !== 'catalog.json');

  // Trouver tous les IDs de cours de base (sans code langue)
  const baseFiles = allJsonFiles.filter(f => {
    const parts = f.replace('.json', '').split('.');
    return parts.length === 1;
  });

  const paths: any[] = [];

  for (const baseFile of baseFiles) {
    const courseId = baseFile.replace('.json', '');
    const availableTranslations = getAvailableTranslations(dataDir, courseId, '/maraichage');

    // Route par défaut (français) : /maraichage/[id]
    const defaultFilePath = path.join(dataDir, baseFile);
    const defaultContent = JSON.parse(fs.readFileSync(defaultFilePath, 'utf-8'));

    paths.push({
      params: { id: courseId },
      props: { 
        course: defaultContent,
        currentLang: DEFAULT_LANGUAGE,
        courseId,
        availableTranslations
      }
    });
  }

  return paths;
}

const { course, currentLang = DEFAULT_LANGUAGE, courseId = course?.id, availableTranslations = [] } = Astro.props;
const langConfig = SUPPORTED_LANGUAGES[currentLang] || SUPPORTED_LANGUAGES[DEFAULT_LANGUAGE];
const isRtl = langConfig.dir === 'rtl';

// Fonction de formatage du texte pédagogique (gras, listes, alertes)
function formatPedagogicalText(rawText: string) {
  if (!rawText) return '<p><em>Contenu technique en cours de finalisation</em></p>';

  let html = rawText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  const lines = html.split('\n');
  let inList = false;
  let listType = 'ul';
  let formattedLines: string[] = [];

  for (let line of lines) {
    line = line.trim();
    if (!line) continue;

    if (line.startsWith('⚠️') || line.toLowerCase().startsWith('attention')) {
      if (inList) { formattedLines.push(`</${listType}>`); inList = false; }
      formattedLines.push(`<div class="slide-alert">${line}</div>`);
      continue;
    }

    const numMatch = line.match(/^(\d+)\.\s+(.*)/);
    if (numMatch) {
      if (!inList || listType !== 'ol') {
        if (inList) formattedLines.push(`</${listType}>`);
        formattedLines.push('<ol>');
        inList = true;
        listType = 'ol';
      }
      formattedLines.push(`<li>${numMatch[2]}</li>`);
      continue;
    }

    const bulletMatch = line.match(/^[-•]\s+(.*)/);
    if (bulletMatch) {
      if (!inList || listType !== 'ul') {
        if (inList) formattedLines.push(`</${listType}>`);
        formattedLines.push('<ul>');
        inList = true;
        listType = 'ul';
      }
      formattedLines.push(`<li>${bulletMatch[1]}</li>`);
      continue;
    }

    if (inList) {
      formattedLines.push(`</${listType}>`);
      inList = false;
    }
    formattedLines.push(`<p>${line}</p>`);
  }

  if (inList) {
    formattedLines.push(`</${listType}>`);
  }

  return formattedLines.join('');
}

const pagesList = course.pages || [];

// Extraction et normalisation des médias au niveau cours (vidéos associées au module)
function normalizeMediaList(mediaData: any): any[] {
  if (!mediaData) return [];
  if (Array.isArray(mediaData)) return mediaData;
  return [mediaData];
}

const langKey = currentLang.startsWith('bm') ? 'bm' : currentLang;
const allVideos = normalizeMediaList(course.media)
  .map(m => ({
    ...m,
    is_main: true,
    page_title: course.title,
    videoId: m.id || (m.url?.includes('v=') ? m.url.split('v=')[1].split('&')[0] : m.url?.split('/').pop())
  }))
  .filter((v: any) => !v.lang || v.lang === langKey || v.lang === currentLang);
const totalSteps = pagesList.length;
const milestones: any[] = [];
if (totalSteps > 1) {
  pagesList.forEach((page: any, idx: number) => {
    milestones.push({
      page,
      idx,
      posPercent: (idx / (totalSteps - 1)) * 100
    });
  });
} else if (totalSteps === 1) {
  milestones.push({
    page: pagesList[0],
    idx: 0,
    posPercent: 50
  });
}
---

<Layout title={course.title} description={course.summary || "Module de formation pratique sur les maraîchage bio-intensif en sol vivant."}>
  <!-- En-tête fixe avec bouton retour et déclencheur d'impression PDF -->
  <div class="lesson-topbar no-print">
    <div class="container lesson-topbar-inner">
      <a href="/maraichage" class="btn btn-outline back-btn" title="Retourner au catalogue des formations">
        ← Catalogue
      </a>
      <div class="lesson-title-meta">
        {course.course_code && <span class="badge badge-code" style="background:#e8f5e9;color:#2e7d32;font-weight:700;">{course.course_code}</span>}
        <span class="badge badge-primary">{course.category || 'Maraîchage Bio-Intensif'}</span>
        <h1 class="lesson-header-title">{course.title}</h1>
        <span class="lesson-reading-progress" id="lesson-reading-progress">
          Partie <strong id="active-step-num">1</strong> / {course.total_pages || pagesList.length}
        </span>
      </div>
      <div class="lesson-actions">
        {availableTranslations.length > 1 && (
          <div class="custom-lang-dropdown" id="custom-lang-dropdown">
            <button 
              type="button" 
              class="custom-lang-trigger" 
              id="custom-lang-trigger" 
              aria-haspopup="listbox" 
              aria-expanded="false"
              aria-label="Changer la langue du cours"
            >
              <span class="custom-lang-globe" aria-hidden="true">🌐</span>
              <span class="custom-lang-current">{langConfig.nativeName}</span>
              <span class="custom-lang-current-short">{langConfig.shortLabel || langConfig.code.toUpperCase()}</span>
              <svg class="custom-lang-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="custom-lang-menu" id="custom-lang-menu" role="listbox" tabindex="-1">
              {availableTranslations.map(tr => (
                <a 
                  href={tr.url} 
                  class:list={['custom-lang-item', { active: tr.lang === currentLang }]}
                  role="option"
                  aria-selected={tr.lang === currentLang}
                  lang={tr.lang}
                >
                  <span class="lang-item-name">{tr.config.nativeName}</span>
                  {tr.lang === currentLang && (
                    <span class="lang-item-check" aria-hidden="true">✓</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}
        <div class="custom-pdf-dropdown" id="custom-pdf-dropdown">
          <button 
            type="button" 
            class="btn btn-primary custom-pdf-trigger" 
            id="custom-pdf-trigger"
            aria-haspopup="listbox" 
            aria-expanded="false"
            title="Télécharger ou imprimer ce cours en PDF"
          >
            🖨️ PDF {langConfig.shortLabel ? `(${langConfig.shortLabel})` : ''}
            <svg class="custom-pdf-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="custom-pdf-menu" id="custom-pdf-menu" role="listbox" tabindex="-1">
            <div class="pdf-menu-section-label">📥 Fiches PDF prêtes à télécharger :</div>
            {availableTranslations.map(tr => {
              const isCurrent = tr.lang === currentLang;
              return (
                <a 
                  href={tr.pdfUrl} 
                  download={tr.pdfFileName}
                  class:list={['custom-pdf-item', { active: isCurrent }]}
                  role="option"
                >
                  <span class="pdf-item-title">
                    📥 Télécharger en {tr.config.nativeName}
                    {isCurrent && <span class="badge-active-lang">Actuelle</span>}
                  </span>
                  <span class="pdf-item-subtitle">{tr.config.name} ({tr.config.shortLabel}) • {tr.pdfFileName}</span>
                </a>
              );
            })}
            <div class="pdf-menu-divider"></div>
            <button type="button" class="custom-pdf-item" id="btn-print-active" role="option">
              <span class="pdf-item-title">🖨️ Imprimer la vue actuelle ({langConfig.nativeName})</span>
              <span class="pdf-item-subtitle">Ouvre la boîte d'impression du navigateur (AirPrint / Imprimante locale)</span>
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="scroll-progress-container" aria-label="Progression de lecture">
      <div class="scroll-progress-bar" id="scroll-progress"></div>
      <div class="progress-ticks-container" id="progress-ticks-container" aria-hidden="true">
        {milestones.map((m: any) => (
          <a 
            href={`#partie-${m.page.page_number}`} 
            class={`progress-step-tick ${m.idx === 0 ? 'active current' : ''}`} 
            style={`left: ${m.posPercent}%`}
            data-page-index={m.idx}
            data-page-num={m.page.page_number}
            data-page-title={m.page.title}
            title={`Partie ${m.page.page_number} / ${totalSteps} : ${m.page.title}`}
          >
            <span class="step-tick-dot"></span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class:list={['container', 'lesson-container', { 'is-rtl': isRtl }]} dir={isRtl ? 'rtl' : 'ltr'} lang={currentLang}>
    <!-- Hero d'introduction du module -->
    <header class="lesson-hero">
      <!-- Cartouche d'en-tête officiel pour l'impression A4 et export PDF -->
      <div class="print-official-banner only-print" aria-hidden="true">
        <div class="print-banner-brand">
          <span class="print-brand-name">CAMPUS NAKÔBIO</span>
          <span class="print-brand-sub">Plateforme Pédagogique Agroécologique &bull; Sahel &amp; Terroirs Tropicaux</span>
        </div>
        <div class="print-banner-meta">
          <span class="print-code-pill">{course.course_code || courseId.split('_')[0].toUpperCase()}</span>
          <span class="print-lang-pill">{langConfig.nativeName}</span>
        </div>
      </div>

      <div class="lesson-badge-row">
        {course.course_code && (
          <span class="badge badge-code" style="background:#e8f5e9;color:#2e7d32;font-weight:700;">{course.course_code}</span>
        )}
        <span class="badge badge-primary">🌱 {course.category || 'Maraîchage Bio-Intensif'}</span>
        <span class="badge badge-neutral">📖 {course.total_pages || pagesList.length} parties</span>
        <span class="badge badge-neutral">☀️ Terroir tropical &amp; sahélien</span>
        {availableTranslations.length > 1 && (
          <span class="badge badge-accent">
            🌐 {langConfig.nativeName}
          </span>
        )}
      </div>

      <h2 class="hero-course-title">{course.title}</h2>
      {course.summary && <p class="hero-course-summary">{course.summary}</p>}

      <!-- Visuel d'illustration de couverture en impression A4 -->
      {(course.cover_image || (pagesList[0] && pagesList[0].image)) && (
        <div class="print-cover-visual only-print" aria-hidden="true">
          <img 
            src={`/${(course.cover_image || pagesList[0].image).replace(/^\//, '')}`} 
            alt={course.title}
          />
        </div>
      )}

      <!-- Table des matières imprimée officielle -->
      {pagesList.length > 0 && (
        <div class="print-table-of-contents only-print" aria-hidden="true">
          <div class="print-toc-title">PROGRAMME DÉTAILLÉ DE LA FORMATION :</div>
          <div class="print-toc-grid">
            {pagesList.map((p: any) => (
              <div class="print-toc-item">
                <span class="print-toc-num">{p.page_number}</span>
                <span class="print-toc-name">{p.title}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Sommaire dépliable -->
      {pagesList.length > 0 && (
        <details class="lesson-quick-toc no-print">
          <summary class="toc-summary-toggle">
            <span class="toc-summary-label">
              📋 Sommaire des chapitres ({pagesList.length} parties)
            </span>
            <span class="toc-toggle-hint">Afficher / Masquer</span>
          </summary>
          <div class="toc-pills-list">
            {pagesList.map((p: any) => (
              <a href={`#partie-${p.page_number}`} class="toc-step-chip">
                <span class="toc-num">{p.page_number}</span>
                <span class="toc-title">{p.title}</span>
              </a>
            ))}
          </div>
        </details>
      )}

      {/* Hub Vidéos dans un accordéon placé sous le sommaire */}
      {allVideos.length > 0 && (
        <details class="video-accordion-hub no-print" aria-label="Supports Vidéos de la formation">
          <summary class="video-accordion-summary">
            <div class="video-summary-left">
              <span class="video-hub-badge-icon">🎥</span>
              <span class="video-hub-summary-title">
                Vidéos & Démonstrations pratiques ({allVideos.length})
              </span>
              <span class="video-hub-lang-tag">{langConfig.shortLabel || currentLang.toUpperCase()}</span>
            </div>
            <span class="video-hub-toggle-hint">Afficher / Masquer</span>
          </summary>

          <div class="video-hub-content">
            <p class="video-hub-intro-text">
              Retrouvez l'ensemble des tutoriels, gestes techniques au champ et podcasts associés à ce module :
            </p>
            <div class={`video-hub-grid video-count-${Math.min(allVideos.length, 6)}`}>
              {allVideos.map((vid: any) => (
                <div class="video-card-item">
                  <LiteYouTube 
                    videoId={vid.videoId} 
                    title={vid.title || vid.page_title}
                  />
                  <div class="video-card-meta">
                    <span class="video-card-tag">{vid.category === 'podcast' ? '🎙️ Podcast' : vid.category === 'pratique' ? '🌱 Pratique' : '⭐ Cours'}</span>
                    <h4 class="video-card-name">{vid.title || vid.page_title}</h4>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </details>
      )}
    </header>

    <!-- Séquence des fiches / parties du cours -->
    <div class="slides-flow">
      {pagesList.map((page: any, idx: number) => {
        const hasImage = page.image && page.image.length > 0;
        const formattedHtml = formatPedagogicalText(page.text);
        const nextPage = pagesList[idx + 1];

        return (
          <article class="slide-unit" id={`partie-${page.page_number}`}>
            <!-- En-tête d'étape -->
            <div class="slide-step-header-bar">
              <div class="step-badge-circle">
                <span class="step-badge-num">{page.page_number}</span>
              </div>
              <div class="step-badge-meta">
                <span class="step-meta-label">PARTIE {page.page_number} SUR {course.total_pages || pagesList.length}</span>
                <span class="step-meta-name">{page.title}</span>
              </div>
            </div>

            <!-- Zone Visuelle : Image du cours ou carnet de croquis pédagogique -->
            <div class="slide-visual-wrapper">
              {hasImage ? (
                <img 
                  src={`/${page.image}`} 
                  alt={page.title} 
                  loading={idx < 2 ? "eager" : "lazy"}
                  decoding="async"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
              ) : null}

              <div 
                class="sketch-placeholder-container" 
                style={hasImage ? "display: none;" : "display: flex;"}
              >
                <div class="sketch-board-frame">
                  <div class="sketch-frame-top">
                    <span class="sketch-type-badge">
                      🎨 Croquis Pédagogique en Préparation
                    </span>
                    <span class="sketch-format-tag">Format 16:9 • Planche Terrain</span>
                  </div>

                  <div class="sketch-desc-body">
                    <div class="sketch-desc-title">Descriptif technique de l'illustration :</div>
                    <blockquote class="sketch-desc-text">
                      « {page.illustration_description || 'Dessin technique de terrain illustrant les gestes clés et observations pratiques de cette étape.'} »
                    </blockquote>
                  </div>

                  <div class="sketch-frame-bottom">
                    <span class="sketch-author-note">
                      Illustration en cours de réalisation par l'équipe graphique
                    </span>
                    <span class="sketch-brand-watermark">NAKÔBIO ACADÉMIE</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Fiche texte pédagogique sous l'image -->
            <div class="slide-body-text">
              <h3 class="slide-step-title">{page.title}</h3>
              <div class="slide-pedagogical-content" set:html={formattedHtml} />
            </div>

            {/* Séparateur élégant et épuré entre les parties du cours */}
            <div class="pedagogical-step-divider no-print">
              <div class="divider-line"></div>
              <span class="divider-dot" aria-hidden="true">•</span>
              <div class="divider-line"></div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Écran de fin de cours -->
    <div class="lesson-footer-completion no-print">
      <div class="completion-icon">🌾</div>
      <h3 class="completion-title">Formation complétée avec succès !</h3>
      <p class="completion-desc">
        Vous avez parcouru l'ensemble des {course.total_pages || pagesList.length} parties de « {course.title} ». 
        Vous pouvez télécharger ce support au format PDF pour vos interventions au champ ou explorer un autre module.
      </p>
      <div class="completion-actions">
        <a href="/maraichage" class="btn btn-primary">Retour au catalogue</a>
        <button type="button" class="btn btn-outline" onclick="window.print()">
          Imprimer la version PDF
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Gestion impression
  document.getElementById('btn-print-lesson')?.addEventListener('click', () => {
    window.print();
  });

  // Barre de défilement dynamique & détection de la partie active
  const progressBar = document.getElementById('scroll-progress');
  const activeStepNum = document.getElementById('active-step-num');
  const stepTicks = document.querySelectorAll<HTMLElement>('.progress-step-tick');
  const slideUnits = document.querySelectorAll<HTMLElement>('.slide-unit');

  function updateProgress() {
    const winScroll = window.scrollY || document.documentElement.scrollTop;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrolled = docHeight > 0 ? (winScroll / docHeight) * 100 : 0;
    
    if (progressBar) {
      progressBar.style.width = Math.min(100, Math.max(0, scrolled)) + '%';
    }

    // Déterminer la section actuellement visible
    let currentStep = '1';
    let currentSlideIdx = 0;
    const triggerLine = window.innerHeight * 0.35;

    slideUnits.forEach((unit, idx) => {
      const rect = unit.getBoundingClientRect();
      if (rect.top <= triggerLine) {
        currentStep = unit.id.replace('partie-', '');
        currentSlideIdx = idx;
      }
    });

    const readingBadge = document.getElementById('lesson-reading-progress');
    if (activeStepNum && activeStepNum.textContent !== currentStep) {
      activeStepNum.textContent = currentStep;
      if (readingBadge) {
        readingBadge.classList.remove('step-changed');
        // Forcer le reflow pour relancer l'animation CSS
        void readingBadge.offsetWidth;
        readingBadge.classList.add('step-changed');
      }
    }

    // Mise à jour de l'état actif/passé des repères de jalons
    let foundCurrent = false;
    // On parcourt de droite à gauche pour déterminer le jalon actif
    const reversedTicks = Array.from(stepTicks).reverse();
    reversedTicks.forEach((tick) => {
      const tickIdx = parseInt(tick.getAttribute('data-page-index') || '0', 10);
      if (tickIdx <= currentSlideIdx) {
        tick.classList.add('active');
        if (!foundCurrent) {
          tick.classList.add('current');
          foundCurrent = true;
        } else {
          tick.classList.remove('current');
        }
      } else {
        tick.classList.remove('active', 'current');
      }
    });
    // Si aucun n'est actif, activer le premier
    if (!foundCurrent && stepTicks[0]) {
      stepTicks[0].classList.add('active', 'current');
    }
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
  // Appel initial
  updateProgress();

  // Gestion du menu déroulant de langues personnalisé
  const langDropdown = document.getElementById('custom-lang-dropdown');
  const langTrigger = document.getElementById('custom-lang-trigger');

  if (langDropdown && langTrigger) {
    langTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      pdfDropdown?.classList.remove('open');
      pdfTrigger?.setAttribute('aria-expanded', 'false');

      const isOpen = langDropdown.classList.toggle('open');
      langTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    document.addEventListener('click', (e) => {
      if (!langDropdown.contains(e.target as Node)) {
        langDropdown.classList.remove('open');
        langTrigger.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && langDropdown.classList.contains('open')) {
        langDropdown.classList.remove('open');
        langTrigger.setAttribute('aria-expanded', 'false');
        langTrigger.focus();
      }
    });
  }

  // Gestion du menu déroulant PDF & Impression
  const pdfDropdown = document.getElementById('custom-pdf-dropdown');
  const pdfTrigger = document.getElementById('custom-pdf-trigger');
  const btnPrintActive = document.getElementById('btn-print-active');

  btnPrintActive?.addEventListener('click', () => {
    pdfDropdown?.classList.remove('open');
    pdfTrigger?.setAttribute('aria-expanded', 'false');
    window.print();
  });

  if (pdfDropdown && pdfTrigger) {
    pdfTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      langDropdown?.classList.remove('open');
      langTrigger?.setAttribute('aria-expanded', 'false');

      const isOpen = pdfDropdown.classList.toggle('open');
      pdfTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    // Fermeture automatique du menu après un clic sur un choix ou téléchargement/impression
    pdfDropdown.querySelectorAll('.custom-pdf-item').forEach((item) => {
      item.addEventListener('click', (e) => {
        const href = item.getAttribute('href');
        pdfDropdown.classList.remove('open');
        pdfTrigger.setAttribute('aria-expanded', 'false');
        if (href === '#print') {
          e.preventDefault();
          window.print();
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!pdfDropdown.contains(e.target as Node)) {
        pdfDropdown.classList.remove('open');
        pdfTrigger.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && pdfDropdown.classList.contains('open')) {
        pdfDropdown.classList.remove('open');
        pdfTrigger.setAttribute('aria-expanded', 'false');
        pdfTrigger.focus();
      }
    });
  }

  // Déclenchement automatique de l'impression si l'URL contient ?print=1
  if (new URLSearchParams(window.location.search).has('print')) {
    window.addEventListener('load', () => {
      setTimeout(() => {
        window.print();
      }, 350);
    });
  }
</script>

<style>
  .lesson-topbar {
    position: sticky;
    top: 70px;
    background: rgba(255, 253, 246, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    z-index: 90;
    box-shadow: var(--shadow-sm);
  }

  .lesson-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 1rem;
  }

  .lesson-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
  }

  /* Menu déroulant de sélection de langue */
  .custom-lang-dropdown {
    position: relative;
  }

  .custom-lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.85rem;
    font-family: var(--font-nko), var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast);
  }

  .custom-lang-trigger:hover {
    background: var(--color-surface-sunken);
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .custom-lang-current-short {
    display: none;
  }

  .custom-lang-globe {
    font-size: 0.95rem;
    line-height: 1;
  }

  .custom-lang-caret {
    color: var(--color-ink-muted);
    transition: transform var(--transition-fast);
  }

  .custom-lang-dropdown.open .custom-lang-caret {
    transform: rotate(180deg);
    color: var(--color-brand-primary);
  }

  .custom-lang-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 175px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 10px 25px rgba(27, 35, 24, 0.12);
    padding: 0.35rem;
    display: none;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 100;
  }

  .custom-lang-dropdown.open .custom-lang-menu {
    display: flex;
    animation: dropdownPop 0.18s ease-out;
  }

  @keyframes dropdownPop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .custom-lang-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-family: var(--font-nko), var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    transition: all var(--transition-fast);
  }

  .custom-lang-item:hover {
    background: var(--color-surface-sunken);
    color: var(--color-brand-primary);
  }

  .custom-lang-item.active {
    background: var(--color-surface-sunken);
    color: var(--color-brand-primary);
    font-weight: 800;
  }

  .lang-item-check {
    color: var(--color-brand-primary);
    font-weight: bold;
    font-size: 0.85rem;
  }

  /* Dropdown PDF & Impression Multilingue */
  .custom-pdf-dropdown {
    position: relative;
    display: inline-block;
  }

  .custom-pdf-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
  }

  .custom-pdf-caret {
    transition: transform var(--transition-fast);
  }

  .custom-pdf-dropdown.open .custom-pdf-caret {
    transform: rotate(180deg);
  }

  .custom-pdf-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 250px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 10px 25px rgba(27, 35, 24, 0.15);
    padding: 0.5rem;
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 100;
  }

  .custom-pdf-dropdown.open .custom-pdf-menu {
    display: flex;
    animation: dropdownPop 0.18s ease-out;
  }

  .custom-pdf-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: all var(--transition-fast);
  }

  .custom-pdf-item:hover {
    background: var(--color-surface-sunken);
  }

  .custom-pdf-item.active {
    background: rgba(47, 74, 52, 0.08);
  }

  .pdf-item-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .pdf-item-subtitle {
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }

  .pdf-menu-divider {
    height: 1px;
    background: var(--color-border);
    margin: 0.25rem 0;
  }

  .pdf-menu-section-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
    padding: 0.25rem 0.75rem 0.15rem;
  }

  .badge-active-lang {
    font-size: 0.68rem;
    font-weight: 700;
    background: var(--color-brand-primary);
    color: #ffffff;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full);
  }

  /* Hub Vidéos sous le sommaire (Accordéon) */
  .video-accordion-hub {
    margin-top: 1.25rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .video-accordion-hub[open] {
    border-color: rgba(47, 74, 52, 0.3);
  }

  .video-accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 1.25rem;
    background: linear-gradient(to right, rgba(47, 74, 52, 0.05), transparent);
    cursor: pointer;
    user-select: none;
    font-family: var(--font-sans);
    transition: background var(--transition-fast);
  }

  .video-accordion-summary:hover {
    background: linear-gradient(to right, rgba(47, 74, 52, 0.09), transparent);
  }

  .video-summary-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .video-hub-badge-icon {
    font-size: 1.2rem;
  }

  .video-hub-summary-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-brand-primary);
  }

  .video-hub-lang-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    background: rgba(47, 74, 52, 0.12);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .video-hub-toggle-hint {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }

  .video-hub-content {
    padding: 1.25rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .video-hub-intro-text {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    margin-bottom: 1.25rem;
  }

  .video-hub-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(150px, 180px));
    justify-content: start;
  }

  /* Adaptation selon le nombre de vidéos */
  .video-hub-grid.video-count-1 {
    grid-template-columns: minmax(150px, 240px);
    justify-content: start;
  }

  .video-hub-grid.video-count-2 {
    grid-template-columns: repeat(2, minmax(150px, 180px));
  }

  .video-hub-grid.video-count-3,
  .video-hub-grid.video-count-4,
  .video-hub-grid.video-count-5,
  .video-hub-grid.video-count-6 {
    grid-template-columns: repeat(auto-fill, minmax(150px, 180px));
    gap: 0.65rem;
  }

  .video-card-item {
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 180px;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .video-card-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .video-card-meta {
    padding: 0.4rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .video-card-tag {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-brand-primary);
    background: rgba(46, 125, 50, 0.1);
    display: inline-block;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    align-self: flex-start;
  }

  .video-card-name {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .divider-dot {
    color: var(--color-border);
    font-size: 1.2rem;
    line-height: 1;
    padding: 0 0.5rem;
  }

  /* Support RTL & Typographie N'ko */
  .lesson-container.is-rtl {
    direction: rtl;
    text-align: right;
  }

  .lesson-container.is-rtl .hero-course-title,
  .lesson-container.is-rtl .slide-step-title,
  .lesson-container.is-rtl .step-meta-name {
    font-family: var(--font-nko), var(--font-sans);
    letter-spacing: normal;
  }

  .lesson-container.is-rtl .slide-pedagogical-content,
  .lesson-container.is-rtl .hero-course-summary,
  .lesson-container.is-rtl .sketch-desc-text {
    font-family: var(--font-nko), var(--font-sans);
    line-height: 1.8;
  }

  .lesson-container.is-rtl .slide-pedagogical-content ul,
  .lesson-container.is-rtl .slide-pedagogical-content ol {
    padding-right: 1.5rem;
    padding-left: 0;
  }

  .lesson-container.is-rtl .slide-alert {
    border-left: none;
    border-right: 4px solid var(--color-brand-secondary);
  }

  .lesson-title-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
    white-space: nowrap;
    flex: 1;
  }

  .lesson-header-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    text-overflow: ellipsis;
    overflow: hidden;
  }

  /* Indicateur discret de partie dans la topbar */
  .lesson-reading-progress {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-left: 0.25rem;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lesson-reading-progress strong {
    color: var(--color-brand-secondary);
    font-weight: 800;
  }

  /* Effet d'animation discret lors du changement d'étape */
  .lesson-reading-progress.step-changed {
    animation: stepPop 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes stepPop {
    0% {
      transform: scale(0.95);
      background-color: var(--color-surface-sunken);
    }
    40% {
      transform: scale(1.08);
      background-color: #F8E6D8;
      border-color: var(--color-brand-secondary);
      box-shadow: 0 0 10px rgba(200, 104, 50, 0.3);
    }
    100% {
      transform: scale(1);
      background-color: var(--color-surface-sunken);
      border-color: var(--color-border);
      box-shadow: none;
    }
  }

  .scroll-progress-container {
    position: relative;
    width: 100%;
    height: 6px;
    background: #e2dac4;
    overflow: visible;
  }

  .scroll-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary), #63981d);
    width: 0%;
    transition: width 0.12s cubic-bezier(0.2, 0, 0, 1);
    position: relative;
    z-index: 2;
  }

  /* Repères visuels verticaux sur la barre pour chaque partie */
  .progress-ticks-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 4;
  }

  .progress-step-tick {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    cursor: pointer;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s ease;
  }

  .step-tick-dot {
    width: 3px;
    height: 10px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.35);
    transition: all 0.2s ease;
    display: block;
  }


  .progress-step-tick:hover {
    transform: translate(-50%, -50%) scale(1.35);
  }

  .progress-step-tick:hover .step-tick-dot {
    width: 4px;
    height: 13px;
    background: #ffffff;
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.6);
  }

  .progress-step-tick.active .step-tick-dot {
    background: #ffffff;
    box-shadow: 0 0 3px rgba(255, 255, 255, 0.95), 0 0 1px rgba(0, 0, 0, 0.3);
  }

  .progress-step-tick.current .step-tick-dot {
    width: 4.5px;
    height: 13px;
    background: #ffffff;
    box-shadow: 0 0 6px rgba(255, 255, 255, 1), 0 0 10px rgba(99, 152, 29, 0.9);
  }

  .lesson-container {
    max-width: 920px;
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  /* Hero Intro */
  .lesson-hero {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2.25rem;
    margin-bottom: 3rem;
    border-left: 6px solid var(--color-brand-primary);
    box-shadow: var(--shadow-sm);
  }

  .lesson-badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .hero-course-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: 0.85rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hero-course-summary {
    font-family: var(--font-sans);
    color: var(--color-ink-soft);
    font-size: 1.08rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  /* Sommaire */
  .lesson-quick-toc {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    margin-top: 0.75rem;
  }

  .toc-summary-toggle {
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0;
    list-style: none;
    user-select: none;
  }

  .toc-summary-toggle::-webkit-details-marker {
    display: none;
  }

  .toc-summary-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .toc-toggle-hint {
    font-size: 0.8rem;
    color: var(--color-ink-faint);
    font-weight: 500;
    white-space: nowrap;
  }

  .toc-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
    max-height: 240px;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .toc-step-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    transition: all var(--transition-base);
  }

  .toc-step-chip:hover {
    border-color: var(--color-brand-primary);
    background: var(--color-surface-sunken);
    color: var(--color-brand-primary);
  }

  .toc-num {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--color-brand-secondary);
  }

  /* Séquence des Fiches */
  .slides-flow {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .slide-unit {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    scroll-margin-top: 145px;
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .slide-unit:hover {
    box-shadow: var(--shadow-md);
    border-color: rgba(47, 74, 52, 0.25);
  }

  .slide-step-header-bar {
    display: flex;
    align-items: center;
    background: var(--color-surface-sunken);
    border-bottom: 1.5px solid var(--color-border);
    padding: 1rem 1.75rem;
    gap: 1.1rem;
  }

  .step-badge-circle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-brand-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(47, 74, 52, 0.2);
  }

  .step-badge-meta {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .step-meta-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-brand-secondary);
    text-transform: uppercase;
  }

  .step-meta-name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Zone Image 16:9 */
  .slide-visual-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #ede6d8;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide-visual-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Carnet de croquis pour illustrations en attente */
  .sketch-placeholder-container {
    width: 100%;
    height: 100%;
    padding: 1.5rem 2rem;
    background: #fbf7ee;
    background-image: radial-gradient(#e4dac8 1px, transparent 1px);
    background-size: 18px 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sketch-board-frame {
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.9);
    border: 2px dashed #bcaa8c;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .sketch-frame-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ebdcc5;
    padding-bottom: 0.6rem;
  }

  .sketch-type-badge {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-primary-deep);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sketch-format-tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .sketch-desc-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-earth);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .sketch-desc-text {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.55;
    color: #2b3324;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sketch-frame-bottom {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border-top: 1px dashed #ebdcc5;
    padding-top: 0.5rem;
    font-weight: 600;
  }

  .sketch-brand-watermark {
    font-weight: 800;
    color: var(--color-primary);
  }

  /* Corps de texte sous l'image */
  .slide-body-text {
    padding: 2.25rem 2.25rem 2.5rem;
    background: var(--color-surface-card);
    border-top: 3px solid var(--color-brand-primary);
  }

  .slide-step-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    margin-bottom: 1.15rem;
    line-height: 1.25;
  }

  .slide-pedagogical-content {
    font-family: var(--font-sans);
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--color-ink);
  }

  .slide-pedagogical-content :global(p) {
    margin-bottom: 1rem;
  }

