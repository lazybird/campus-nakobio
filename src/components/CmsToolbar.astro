---
import { hashSha256 } from '../utils/auth';

interface Props {
  adminSecret?: string;
  gitEnabled?: boolean;
}

const rawSecret =
  Astro.props.adminSecret ||
  import.meta.env.CMS_ADMIN_SECRET ||
  process.env.CMS_ADMIN_SECRET ||
  '';
const hashedSecret = rawSecret ? await hashSha256(rawSecret) : '';

const envGitEnabled =
  import.meta.env.CMS_GIT_ENABLED ?? process.env.CMS_GIT_ENABLED;
const gitEnabled =
  Astro.props.gitEnabled !== undefined
    ? Astro.props.gitEnabled
    : String(envGitEnabled).toLowerCase() === 'true' || String(envGitEnabled) === '1';
---

<div
  id="nakobio-cms-root"
  data-secret={hashedSecret}
  data-git-enabled={gitEnabled ? 'true' : 'false'}
  class="hidden"
>
  <div class="cms-bar">
    <div class="cms-left">
      <span class="cms-badge">
        <span class="cms-dot"></span>
        Éditeur Pédagogique
      </span>
      <div class="cms-modes">
        <button type="button" id="cms-btn-preview" class="cms-btn active">
          Aperçu
        </button>
        <button type="button" id="cms-btn-edit" class="cms-btn">
          Éditer le cours
        </button>
      </div>
    </div>

    <div class="cms-right">
      <span id="cms-draft-indicator" class="cms-draft-pill hidden">0 modif(s)</span>
      <button type="button" id="cms-btn-reset" class="cms-btn cms-btn-danger" title="Annuler les modifications locales en attente">
        Annuler
      </button>
      <button type="button" id="cms-btn-save" class="cms-btn cms-btn-primary" title="Enregistrer et mettre en ligne les modifications">
        Enregistrer
      </button>
      <a href="/api/auth/logout" class="cms-btn-logout" title="Déconnexion">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </a>
    </div>
  </div>

  <!-- Modal pour modifier le contenu Texte / Rich Text -->
  <dialog id="cms-text-modal" class="cms-modal">
    <div class="cms-modal-box cms-modal-box--rich">
      <div class="cms-modal-header">
        <div class="cms-modal-title-area">
          <svg class="cms-modal-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <h3 id="cms-text-modal-title">Édition du contenu</h3>
        </div>
        <span id="cms-text-target-badge" class="cms-field-badge">champ</span>
        <button type="button" id="cms-text-close" class="cms-modal-close-btn" aria-label="Fermer (Échap)">&times;</button>
      </div>

      <div class="cms-modal-body">
        <!-- Champ Input Simple pour Titres courts -->
        <div id="cms-input-simple-container" class="cms-form-group">
          <label for="cms-text-input-simple" class="cms-form-label">Texte du titre</label>
          <input
            type="text"
            id="cms-text-input-simple"
            class="cms-form-input"
            placeholder="Titre..."
          />
        </div>

        <!-- Éditeur Rich Text complet (Inspiré de sites-faciles / Tiptap) -->
        <div id="cms-richtext-container" class="cms-form-group hidden">
          <label class="cms-form-label">Contenu formaté (Rich Text)</label>
          <div class="cms-richtext-toolbar" role="toolbar" aria-label="Outils de mise en forme">
            <button type="button" class="cms-tool-btn" data-action="bold" title="Gras (Ctrl+B)"><b>B</b></button>
            <button type="button" class="cms-tool-btn" data-action="italic" title="Italique (Ctrl+I)"><i>I</i></button>
            <button type="button" class="cms-tool-btn" data-action="strike" title="Barré"><s>S</s></button>
            <span class="cms-tool-sep"></span>
            <button type="button" class="cms-tool-btn" data-action="h2" title="Titre de section H2">H2</button>
            <button type="button" class="cms-tool-btn" data-action="h3" title="Sous-titre H3">H3</button>
            <button type="button" class="cms-tool-btn" data-action="p" title="Paragraphe normal">P</button>
            <span class="cms-tool-sep"></span>
            <button type="button" class="cms-tool-btn" data-action="bulletList" title="Liste à puces">• Liste</button>
            <button type="button" class="cms-tool-btn" data-action="orderedList" title="Liste numérotée">1. Liste</button>
            <button type="button" class="cms-tool-btn" data-action="blockquote" title="Citation / Bloc note">« » Note</button>
            <span class="cms-tool-sep"></span>
            <button type="button" class="cms-tool-btn cms-tool-alert" data-action="alert" title="Encadré d'alerte / vigilance (basculer)">⚠️ Alerte</button>
            <button type="button" class="cms-tool-btn cms-tool-tip" data-action="tip" title="Encadré conseil / astuce (basculer)">💡 Conseil</button>
            <button type="button" class="cms-tool-btn" data-action="table" title="Insérer un tableau simple">⊞ Tableau</button>
            <span class="cms-tool-sep"></span>
            <button type="button" class="cms-tool-btn" data-action="undo" title="Annuler (Ctrl+Z)">↩</button>
            <button type="button" class="cms-tool-btn" data-action="redo" title="Rétablir (Ctrl+Y)">↪</button>
          </div>

          <div
            id="cms-richtext-editor"
            class="cms-richtext-content"
            role="textbox"
            aria-multiline="true"
          ></div>
        </div>
      </div>

      <div class="cms-modal-actions">
        <button type="button" id="cms-text-cancel" class="cms-modal-btn">Annuler (Échap)</button>
        <button type="button" id="cms-text-save" class="cms-modal-btn cms-btn-primary">Appliquer</button>
      </div>
    </div>
  </dialog>

  <!-- Modal pour remplacer une image de slide -->
  <dialog id="cms-image-modal" class="cms-modal">
    <div class="cms-modal-box">
      <div class="cms-modal-header">
        <div class="cms-modal-title-area">
          <svg class="cms-modal-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <h3>Modifier l'illustration de la page</h3>
        </div>
        <span id="cms-image-target-label" class="cms-field-badge">image</span>
        <button type="button" id="cms-image-close" class="cms-modal-close-btn" aria-label="Fermer (Échap)">&times;</button>
      </div>
      
      <div class="cms-upload-area">
        <label for="cms-image-file-input" class="cms-upload-label">
          <span>Sélectionner une nouvelle image (PNG, JPG, WebP)</span>
          <input type="file" id="cms-image-file-input" accept="image/*" />
        </label>
        <div id="cms-image-preview-box" class="hidden">
          <img id="cms-image-preview" src="" alt="Aperçu" />
        </div>
      </div>

      <div class="cms-modal-actions">
        <button type="button" id="cms-image-cancel" class="cms-modal-btn">Annuler (Échap)</button>
        <button type="button" id="cms-image-save" class="cms-modal-btn cms-btn-primary">Valider l'image</button>
      </div>
    </div>
  </dialog>

  <!-- Modal pour les Labels & Commentaires Éditoriaux de Chapitre -->
  <dialog id="cms-editorial-modal" class="cms-modal">
    <div class="cms-modal-box">
      <div class="cms-modal-header">
        <div class="cms-modal-title-area">
          <svg class="cms-modal-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <h3 id="cms-editorial-modal-title">Revue éditoriale du chapitre</h3>
        </div>
        <span id="cms-editorial-target-badge" class="cms-field-badge">page</span>
        <button type="button" id="cms-editorial-close" class="cms-modal-close-btn" aria-label="Fermer (Échap)">&times;</button>
      </div>

      <div class="cms-modal-body">
        <div class="cms-form-group">
          <label class="cms-form-label">Drapeaux de révision (Labels)</label>
          <div class="cms-flags-selector">
            <label class="cms-flag-item">
              <input type="checkbox" id="cms-flag-text" value="text_review" />
              <span class="cms-flag-label">
                <span class="cms-flag-icon">✏️</span>
                <span>Texte à revoir</span>
              </span>
            </label>
            <label class="cms-flag-item">
              <input type="checkbox" id="cms-flag-image" value="image_review" />
              <span class="cms-flag-label">
                <span class="cms-flag-icon">🖼️</span>
                <span>Image à revoir</span>
              </span>
            </label>
          </div>
        </div>

        <div class="cms-form-group">
          <label for="cms-editorial-comment" class="cms-form-label">Commentaire réservé à l'équipe éditoriale</label>
          <textarea
            id="cms-editorial-comment"
            class="cms-form-textarea"
            rows="4"
            placeholder="Notes internes, consignes de retouche ou remarques sur cette page..."
          ></textarea>
        </div>
      </div>

      <div class="cms-modal-actions">
        <button type="button" id="cms-editorial-cancel" class="cms-modal-btn">Annuler (Échap)</button>
        <button type="button" id="cms-editorial-save" class="cms-modal-btn cms-btn-primary">Appliquer les retours</button>
      </div>
    </div>
  </dialog>

  <!-- Modal de confirmation moderne intégrée (remplace window.confirm) -->
  <dialog id="cms-confirm-modal" class="cms-modal">
    <div class="cms-modal-box cms-modal-box--confirm">
      <div class="cms-confirm-header">
        <div id="cms-confirm-icon-box" class="cms-confirm-icon-box"></div>
        <div class="cms-confirm-texts">
          <h3 id="cms-confirm-title">Confirmation</h3>
          <p id="cms-confirm-message"></p>
        </div>
      </div>
      <div class="cms-modal-actions">
        <button type="button" id="cms-confirm-cancel-btn" class="cms-modal-btn">Annuler</button>
        <button type="button" id="cms-confirm-ok-btn" class="cms-modal-btn cms-btn-primary">Confirmer</button>
      </div>
    </div>
  </dialog>

  <!-- Conteneur de notifications Toasts intégrées (remplace window.alert) -->
  <div id="cms-toast-container" class="cms-toast-container" aria-live="polite"></div>
</div>

<script>
  import { getAdminCookieToken } from '../utils/auth';

  async function checkAndInitCms() {
    const root = document.getElementById('nakobio-cms-root');
    if (!root) return;

    let expectedSecret = root.getAttribute('data-secret');
    const token = getAdminCookieToken();

    // Si la page a été pré-rendue statiquement sans le secret au build time,
    // ou pour valider dynamiquement la session, on interroge /api/cms/status
    let isAuthorized = false;
    if (expectedSecret && token && token === expectedSecret) {
      isAuthorized = true;
    } else if (token) {
      try {
        const res = await fetch('/api/cms/status', {
          headers: {
            'Authorization': `Bearer ${token}`
          }
        });
        if (res.ok) {
          const data = await res.json();
          if (data && data.authenticated) {
            isAuthorized = true;
            if (data.git && data.git.enabled !== undefined) {
              root.setAttribute('data-git-enabled', String(data.git.enabled));
            }
          }
        }
      } catch (err) {
        // En cas d'erreur réseau, on ignore silencieusement
      }
    }

    if (isAuthorized) {
      document.body.classList.add('cms-auth-active');
      root.classList.remove('hidden');
      initCmsToolbar();
    }
  }

  checkAndInitCms();

  function initCmsToolbar() {
    let mode: 'preview' | 'edit' = 'preview';
    const btnPreview = document.getElementById('cms-btn-preview');
    const btnEdit = document.getElementById('cms-btn-edit');
    const btnReset = document.getElementById('cms-btn-reset');
    const btnSave = document.getElementById('cms-btn-save');
    const draftIndicator = document.getElementById('cms-draft-indicator');

    // Modales
    const textModal = document.getElementById('cms-text-modal') as HTMLDialogElement | null;
    const textModalTitle = document.getElementById('cms-text-modal-title');
    const textTargetBadge = document.getElementById('cms-text-target-badge');
    const textInputSimpleContainer = document.getElementById('cms-input-simple-container');
    const textInputSimple = document.getElementById('cms-text-input-simple') as HTMLInputElement | null;
    const richtextContainer = document.getElementById('cms-richtext-container');
    const richtextEditor = document.getElementById('cms-richtext-editor') as HTMLDivElement | null;
    const textCloseBtn = document.getElementById('cms-text-close');
    const textCancelBtn = document.getElementById('cms-text-cancel');
    const textSaveBtn = document.getElementById('cms-text-save');

    const imageModal = document.getElementById('cms-image-modal') as HTMLDialogElement | null;
    const imageFileInput = document.getElementById('cms-image-file-input') as HTMLInputElement | null;
    const imagePreviewBox = document.getElementById('cms-image-preview-box');
    const imagePreview = document.getElementById('cms-image-preview') as HTMLImageElement | null;
    const imageLabel = document.getElementById('cms-image-target-label');
    const imageCloseBtn = document.getElementById('cms-image-close');
    const imageCancel = document.getElementById('cms-image-cancel');
    const imageSaveBtn = document.getElementById('cms-image-save');

    // Modale Revue Éditoriale
    const editorialModal = document.getElementById('cms-editorial-modal') as HTMLDialogElement | null;
    const editorialModalTitle = document.getElementById('cms-editorial-modal-title');
    const editorialTargetBadge = document.getElementById('cms-editorial-target-badge');
    const editorialFlagText = document.getElementById('cms-flag-text') as HTMLInputElement | null;
    const editorialFlagImage = document.getElementById('cms-flag-image') as HTMLInputElement | null;
    const editorialComment = document.getElementById('cms-editorial-comment') as HTMLTextAreaElement | null;
    const editorialCloseBtn = document.getElementById('cms-editorial-close');
    const editorialCancelBtn = document.getElementById('cms-editorial-cancel');
    const editorialSaveBtn = document.getElementById('cms-editorial-save');

    // Dialogue de confirmation intégré
    const confirmModal = document.getElementById('cms-confirm-modal') as HTMLDialogElement | null;
    const confirmTitle = document.getElementById('cms-confirm-title');
    const confirmMessage = document.getElementById('cms-confirm-message');
    const confirmIconBox = document.getElementById('cms-confirm-icon-box');
    const confirmCancelBtn = document.getElementById('cms-confirm-cancel-btn') as HTMLButtonElement | null;
    const confirmOkBtn = document.getElementById('cms-confirm-ok-btn') as HTMLButtonElement | null;

    // Conteneur de toasts intégrés
    const toastContainer = document.getElementById('cms-toast-container');

    // Système de toasts modernes
    function showToast(message: string, type: 'info' | 'success' | 'warning' | 'error' = 'info', duration = 4500) {
      if (!toastContainer) return;

      const toast = document.createElement('div');
      toast.className = `cms-toast cms-toast--${type}`;

      const iconSvg = {
        success: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
        error: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`,
        warning: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`,
        info: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`
      }[type];

      toast.innerHTML = `
        <div class="cms-toast-icon">${iconSvg}</div>
        <div class="cms-toast-msg">${message}</div>
        <button type="button" class="cms-toast-close" aria-label="Fermer">&times;</button>
      `;

      toastContainer.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.add('cms-toast--visible');
      });

      let timer: any = null;

      function removeToast() {
        if (!toast.parentNode) return;
        if (timer) clearTimeout(timer);
        toast.classList.remove('cms-toast--visible');
        toast.classList.add('cms-toast--hiding');
        setTimeout(() => {
          toast.remove();
        }, 250);
      }

      toast.querySelector('.cms-toast-close')?.addEventListener('click', removeToast);

      if (duration > 0) {
        timer = setTimeout(removeToast, duration);
      }
    }

    // Système de confirmation asynchrone intégré
    function showConfirm(options: {
      title?: string;
      message: string;
      confirmText?: string;
      cancelText?: string;
      isDanger?: boolean;
    }): Promise<boolean> {
      return new Promise((resolve) => {
        if (!confirmModal || !confirmOkBtn || !confirmCancelBtn) {
          resolve(window.confirm(options.message));
          return;
        }

        if (confirmTitle) confirmTitle.textContent = options.title || 'Confirmation requise';
        if (confirmMessage) confirmMessage.textContent = options.message;
        confirmOkBtn.textContent = options.confirmText || 'Confirmer';
        confirmCancelBtn.textContent = options.cancelText || 'Annuler';

        if (options.isDanger) {
          confirmOkBtn.className = 'cms-modal-btn cms-btn-danger-solid';
          if (confirmIconBox) {
            confirmIconBox.className = 'cms-confirm-icon-box cms-confirm-icon-box--danger';
            confirmIconBox.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`;
          }
        } else {
          confirmOkBtn.className = 'cms-modal-btn cms-btn-primary';
          if (confirmIconBox) {
            confirmIconBox.className = 'cms-confirm-icon-box cms-confirm-icon-box--primary';
            confirmIconBox.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
          }
        }

        let resolved = false;

        function cleanup(val: boolean) {
          if (resolved) return;
          resolved = true;
          confirmModal?.close();
          confirmOkBtn?.removeEventListener('click', onOk);
          confirmCancelBtn?.removeEventListener('click', onCancel);
          confirmModal?.removeEventListener('cancel', onCancel);
          resolve(val);
        }

        function onOk() { cleanup(true); }
        function onCancel() { cleanup(false); }

        confirmOkBtn.addEventListener('click', onOk);
        confirmCancelBtn.addEventListener('click', onCancel);
        confirmModal.addEventListener('cancel', onCancel, { once: true });

        confirmModal.showModal();
      });
    }

    let currentActiveElement: HTMLElement | null = null;
    let currentBindKey: string | null = null;
    let isRichText = false;

    let currentImageBindKey: string | null = null;
    let currentImageElement: HTMLImageElement | null = null;
    let selectedFile: File | null = null;

    let currentEditorialBtn: HTMLElement | null = null;
    let currentEditorialBindKey: string | null = null;
    let currentEditorialPageIndex: string | null = null;

    function getDrafts(): Record<string, string> {
      try {
        return JSON.parse(localStorage.getItem('campus_cms_drafts') || '{}');
      } catch {
        return {};
      }
    }

    function setDrafts(drafts: Record<string, string>) {
      localStorage.setItem('campus_cms_drafts', JSON.stringify(drafts));
      updateDraftUI();
    }

    function updateDraftUI() {
      const drafts = getDrafts();
      const count = Object.keys(drafts).length;
      if (draftIndicator) {
        if (count > 0) {
          draftIndicator.textContent = `${count} modif(s)`;
          draftIndicator.classList.remove('hidden');
        } else {
          draftIndicator.classList.add('hidden');
        }
      }

      // Appliquer les brouillons visuellement dans la page
      document.querySelectorAll('[data-cms-bind]').forEach((el) => {
        const bindKey = el.getAttribute('data-cms-bind');
        if (bindKey && drafts[bindKey] !== undefined) {
          if (el.tagName === 'IMG') {
            const rawVal = drafts[bindKey];
            const cleanSrc = rawVal.startsWith('/') ? rawVal : `/${rawVal}`;
            (el as HTMLImageElement).src = cleanSrc;
            (el as HTMLElement).style.display = 'block';
            const placeholder = (el as HTMLElement).nextElementSibling as HTMLElement | null;
            if (placeholder && placeholder.classList.contains('sketch-placeholder-container')) {
              placeholder.style.display = 'none';
            }
          } else {
            el.innerHTML = drafts[bindKey];
          }
          el.setAttribute('data-cms-has-draft', 'true');
        } else {
          el.removeAttribute('data-cms-has-draft');
        }
      });

      // Appliquer les brouillons éditoriaux (drapeaux et commentaires)
      document.querySelectorAll('.editorial-edit-btn').forEach((btn) => {
        const bindKey = btn.getAttribute('data-editorial-bind');
        const pageIdx = btn.getAttribute('data-page-index');
        if (bindKey && drafts[bindKey] !== undefined) {
          try {
            const data = JSON.parse(drafts[bindKey]);
            const flags: string[] = Array.isArray(data.flags) ? data.flags : [];
            const comment: string = typeof data.comment === 'string' ? data.comment.trim() : '';

            // Mise à jour des attributs sur le bouton
            btn.setAttribute('data-editorial-flags', JSON.stringify(flags));
            btn.setAttribute('data-editorial-comment', comment);

            // Mise à jour de la carte éditoriale dans la page
            const card = document.querySelector(`.slide-editorial-card[data-editorial-display="${pageIdx}"]`) as HTMLElement | null;
            const hasAny = flags.length > 0 || comment.length > 0;

            if (card) {
              if (hasAny) {
                card.style.display = 'block';
                const flagsContainer = card.querySelector('.slide-editorial-flags');
                if (flagsContainer) {
                  let html = '';
                  if (flags.includes('text_review')) html += '<span class="editorial-badge-pill editorial-badge-pill--text">✏️ Texte à revoir</span> ';
                  if (flags.includes('image_review')) html += '<span class="editorial-badge-pill editorial-badge-pill--image">🖼️ Image à revoir</span>';
                  flagsContainer.innerHTML = html;
                }
                let commentP = card.querySelector('.slide-editorial-comment');
                if (comment) {
                  if (!commentP) {
                    commentP = document.createElement('p');
                    commentP.className = 'slide-editorial-comment';
                    card.appendChild(commentP);
                  }
                  commentP.textContent = comment;
                } else if (commentP) {
                  commentP.remove();
                }
              } else {
                card.style.display = 'none';
              }
            } else if (hasAny && pageIdx !== null) {
              // Créer la carte dynamiquement si elle n'existait pas au rendu initial
              const article = document.querySelector(`.slide-unit#partie-${parseInt(pageIdx, 10) + 1}`) ||
                              document.querySelectorAll('.slide-unit')[parseInt(pageIdx, 10)];
              if (article) {
                const headerBar = article.querySelector('.slide-step-header-bar');
                if (headerBar) {
                  const newCard = document.createElement('div');
                  newCard.className = 'slide-editorial-card editorial-auth-only no-print';
                  newCard.setAttribute('data-editorial-display', pageIdx);
                  let flagsHtml = '';
                  if (flags.includes('text_review')) flagsHtml += '<span class="editorial-badge-pill editorial-badge-pill--text">✏️ Texte à revoir</span> ';
                  if (flags.includes('image_review')) flagsHtml += '<span class="editorial-badge-pill editorial-badge-pill--image">🖼️ Image à revoir</span>';

                  newCard.innerHTML = `
                    <div class="slide-editorial-header">
                      <span class="slide-editorial-title"><span>⚠️ Note pour l'équipe d'édition</span></span>
                      <div class="slide-editorial-flags">${flagsHtml}</div>
                    </div>
                    ${comment ? `<p class="slide-editorial-comment">${comment}</p>` : ''}
                  `;
                  headerBar.insertAdjacentElement('afterend', newCard);
                }
              }
            }

            // Mise à jour du badge dans le sommaire rapide
            const tocBadge = document.querySelector(`.toc-editorial-badge[data-page-index="${pageIdx}"]`) as HTMLElement | null;
            if (tocBadge) {
              tocBadge.style.display = hasAny ? 'inline-flex' : 'none';
            } else if (hasAny && pageIdx !== null) {
              const chip = document.querySelectorAll('.toc-step-chip')[parseInt(pageIdx, 10)];
              if (chip) {
                const newBadge = document.createElement('span');
                newBadge.className = 'toc-editorial-badge editorial-auth-only';
                newBadge.setAttribute('data-page-index', pageIdx);
                newBadge.setAttribute('title', 'Chapitre marqué pour revue');
                newBadge.textContent = '⚠️ À revoir';
                chip.appendChild(newBadge);
              }
            }
          } catch (e) {
            // Ignorer si format invalide
          }
        }
      });
    }

    function setMode(newMode: 'preview' | 'edit') {
      mode = newMode;
      if (mode === 'edit') {
        document.body.classList.add('cms-mode-editing');
        btnEdit?.classList.add('active');
        btnPreview?.classList.remove('active');
        enableClickEditing();
      } else {
        document.body.classList.remove('cms-mode-editing');
        btnPreview?.classList.add('active');
        btnEdit?.classList.remove('active');
        disableClickEditing();
        closeModals();
      }
    }

    btnPreview?.addEventListener('click', () => setMode('preview'));
    btnEdit?.addEventListener('click', () => setMode('edit'));

    function enableClickEditing() {
      document.querySelectorAll('[data-cms-bind]').forEach((el) => {
        if (el.tagName === 'IMG') {
          el.setAttribute('title', 'Cliquez pour changer cette illustration (Modale)');
          el.addEventListener('click', onImageClick as any);
        } else {
          el.setAttribute('title', 'Cliquez pour éditer ce contenu en modale');
          el.addEventListener('click', onTextElementClick as any);
        }
      });
    }

    function disableClickEditing() {
      document.querySelectorAll('[data-cms-bind]').forEach((el) => {
        el.removeAttribute('title');
        el.removeEventListener('click', onImageClick as any);
        el.removeEventListener('click', onTextElementClick as any);
        el.removeAttribute('data-cms-active');
      });
    }

    // Gestion de l'éditeur Rich Text Tiptap / ProseMirror (chargé dynamiquement)
    type RichTextController = import('../utils/cmsRichTextEditor').CmsRichTextController;
    let richTextController: RichTextController | null = null;
    const toolButtons = Array.from(document.querySelectorAll('.cms-tool-btn'));

    function syncToolbarActiveStates() {
      if (!richTextController) return;
      toolButtons.forEach((btn) => {
        const action = btn.getAttribute('data-action');
        if (!action) return;
        btn.classList.toggle('is-active', richTextController!.isActive(action));
      });
    }

    async function ensureRichTextEditor(initialHtml: string) {
      if (!richtextEditor) return;
      if (!richTextController) {
        const { createCmsRichTextEditor } = await import('../utils/cmsRichTextEditor');
        richTextController = createCmsRichTextEditor(
          richtextEditor,
          initialHtml,
          syncToolbarActiveStates
        );
      } else {
        richTextController.setContent(initialHtml);
      }
      syncToolbarActiveStates();
    }

    // Gestion de l'ouverture de la modale de texte / richtext
    async function onTextElementClick(e: MouseEvent) {
      if (mode !== 'edit') return;
      e.preventDefault();
      e.stopPropagation();

      const el = e.currentTarget as HTMLElement;
      currentActiveElement = el;
      currentBindKey = el.getAttribute('data-cms-bind');
      if (!currentBindKey) return;

      document.querySelectorAll('[data-cms-active]').forEach(activeEl => activeEl.removeAttribute('data-cms-active'));
      el.setAttribute('data-cms-active', 'true');

      if (textTargetBadge) textTargetBadge.textContent = currentBindKey;

      // Détecter si le champ nécessite le mode Rich Text ou un Input simple
      // Par exemple : .slide-pedagogical-content, textes longs ou résumés multi-lignes
      isRichText = el.classList.contains('slide-pedagogical-content') || 
                   el.tagName === 'DIV' || 
                   currentBindKey.endsWith('.text') ||
                   (el.textContent && el.textContent.length > 80);

      const drafts = getDrafts();
      const currentVal = drafts[currentBindKey] ?? el.innerHTML.trim();

      if (isRichText) {
        if (textModalTitle) textModalTitle.textContent = "Éditeur de texte pédagogique (Rich Text)";
        textInputSimpleContainer?.classList.add('hidden');
        richtextContainer?.classList.remove('hidden');
        textModal?.showModal();
        await ensureRichTextEditor(currentVal);
        setTimeout(() => richTextController?.focus(), 30);
      } else {
        if (textModalTitle) textModalTitle.textContent = "Édition du titre";
        richtextContainer?.classList.add('hidden');
        textInputSimpleContainer?.classList.remove('hidden');
        if (textInputSimple) {
          textInputSimple.value = drafts[currentBindKey] ?? el.textContent?.trim() ?? '';
        }
        textModal?.showModal();
        setTimeout(() => {
          textInputSimple?.focus();
          textInputSimple?.select();
        }, 50);
      }
    }

    // Application de la modification du texte
    textSaveBtn?.addEventListener('click', () => {
      if (!currentBindKey || !currentActiveElement) return;

      const drafts = getDrafts();
      let newValue = '';

      if (isRichText && richTextController) {
        newValue = richTextController.getHTML();
        currentActiveElement.innerHTML = newValue;
      } else if (textInputSimple) {
        newValue = textInputSimple.value.trim();
        currentActiveElement.textContent = newValue;
      }

      drafts[currentBindKey] = newValue;
      setDrafts(drafts);
      closeModals();
    });

    // Raccourci Entrée pour les champs simples
    textInputSimple?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        textSaveBtn?.click();
      }
    });

    // Outils de formatage Rich Text (Tiptap / ProseMirror)
    toolButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const action = btn.getAttribute('data-action');
        if (!action || !richTextController) return;
        richTextController.runAction(action);
      });
    });

    // Fermeture des modales
    function closeModals() {
      textModal?.close();
      imageModal?.close();
      editorialModal?.close();
      if (currentActiveElement) {
        currentActiveElement.removeAttribute('data-cms-active');
        currentActiveElement = null;
      }
      currentEditorialBtn = null;
      currentEditorialBindKey = null;
      currentEditorialPageIndex = null;
    }

    textCloseBtn?.addEventListener('click', closeModals);
    textCancelBtn?.addEventListener('click', closeModals);
    imageCloseBtn?.addEventListener('click', closeModals);
    imageCancel?.addEventListener('click', closeModals);
    editorialCloseBtn?.addEventListener('click', closeModals);
    editorialCancelBtn?.addEventListener('click', closeModals);

    // Support systématique de la touche Échap et clic backdrop
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModals();
      }
    });

    [textModal, imageModal, editorialModal].forEach((dialog) => {
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) {
          closeModals();
        }
      });
    });

    // Gestion de l'ouverture de la modale éditoriale
    function onEditorialBtnClick(e: MouseEvent) {
      e.preventDefault();
      e.stopPropagation();

      const btn = e.currentTarget as HTMLElement;
      currentEditorialBtn = btn;
      currentEditorialBindKey = btn.getAttribute('data-editorial-bind');
      currentEditorialPageIndex = btn.getAttribute('data-page-index');
      const pageTitle = btn.getAttribute('data-page-title') || 'Chapitre';

      if (!currentEditorialBindKey) return;

      if (editorialModalTitle) {
        editorialModalTitle.textContent = `Revue éditoriale : ${pageTitle}`;
      }
      if (editorialTargetBadge) {
        editorialTargetBadge.textContent = currentEditorialBindKey;
      }

      // Lire les valeurs actuelles (brouillons ou attributs du bouton)
      const drafts = getDrafts();
      let currentFlags: string[] = [];
      let currentComment = '';

      if (drafts[currentEditorialBindKey] !== undefined) {
        try {
          const parsed = JSON.parse(drafts[currentEditorialBindKey]);
          currentFlags = Array.isArray(parsed.flags) ? parsed.flags : [];
          currentComment = typeof parsed.comment === 'string' ? parsed.comment : '';
        } catch {
          currentFlags = [];
          currentComment = '';
        }
      } else {
        try {
          const rawFlags = btn.getAttribute('data-editorial-flags') || '[]';
          currentFlags = JSON.parse(rawFlags);
        } catch {
          currentFlags = [];
        }
        currentComment = btn.getAttribute('data-editorial-comment') || '';
      }

      if (editorialFlagText) editorialFlagText.checked = currentFlags.includes('text_review');
      if (editorialFlagImage) editorialFlagImage.checked = currentFlags.includes('image_review');
      if (editorialComment) editorialComment.value = currentComment;

      editorialModal?.showModal();
    }

    // Sauvegarde de la modale éditoriale
    editorialSaveBtn?.addEventListener('click', () => {
      if (!currentEditorialBindKey) return;

      const flags: string[] = [];
      if (editorialFlagText?.checked) flags.push('text_review');
      if (editorialFlagImage?.checked) flags.push('image_review');

      const comment = (editorialComment?.value || '').trim();

      const drafts = getDrafts();
      drafts[currentEditorialBindKey] = JSON.stringify({
        flags,
        comment,
      });

      setDrafts(drafts);
      closeModals();
      showToast('Retours éditoriaux enregistrés dans le brouillon.', 'success');
    });

    // Attacher les écouteurs sur tous les boutons de revue éditoriale
    document.querySelectorAll('.editorial-edit-btn').forEach((btn) => {
      btn.addEventListener('click', onEditorialBtnClick as any);
    });

    confirmModal?.addEventListener('click', (e) => {
      if (e.target === confirmModal) {
        confirmCancelBtn?.click();
      }
    });

    // Gestion de l'upload d'image
    function onImageClick(e: MouseEvent) {
      if (mode !== 'edit') return;
      e.preventDefault();
      e.stopPropagation();

      currentImageElement = e.currentTarget as HTMLImageElement;
      currentImageBindKey = currentImageElement.getAttribute('data-cms-bind');
      if (imageLabel && currentImageBindKey) {
        imageLabel.textContent = currentImageBindKey;
      }
      if (imageFileInput) imageFileInput.value = '';
      if (imagePreviewBox) imagePreviewBox.classList.add('hidden');
      selectedFile = null;

      imageModal?.showModal();
    }

    imageFileInput?.addEventListener('change', () => {
      if (imageFileInput.files && imageFileInput.files[0]) {
        selectedFile = imageFileInput.files[0];
        const reader = new FileReader();
        reader.onload = (e) => {
          if (imagePreview && e.target?.result) {
            imagePreview.src = e.target.result as string;
            imagePreviewBox?.classList.remove('hidden');
          }
        };
        reader.readAsDataURL(selectedFile);
      }
    });

    imageSaveBtn?.addEventListener('click', async () => {
      if (!selectedFile || !currentImageBindKey) {
        showToast('Veuillez sélectionner un fichier image.', 'warning');
        return;
      }

      if (imageSaveBtn) {
        imageSaveBtn.textContent = 'Envoi en cours...';
        imageSaveBtn.setAttribute('disabled', 'true');
      }

      try {
        const formData = new FormData();
        formData.append('file', selectedFile);

        const res = await fetch('/api/cms/upload', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();
        const uploadedUrl = data.fileUrl || data.url;
        if (data.success && uploadedUrl) {
          const cleanUrl = uploadedUrl.startsWith('/') ? uploadedUrl : `/${uploadedUrl}`;
          const drafts = getDrafts();
          drafts[currentImageBindKey] = cleanUrl.replace(/^\//, '');
          setDrafts(drafts);
          if (currentImageElement) {
            currentImageElement.src = cleanUrl;
            currentImageElement.style.display = 'block';
            const placeholder = currentImageElement.nextElementSibling as HTMLElement | null;
            if (placeholder && placeholder.classList.contains('sketch-placeholder-container')) {
              placeholder.style.display = 'none';
            }
          }
          closeModals();
          showToast('Image mise à jour dans le brouillon.', 'success');
        } else {
          showToast(`Erreur lors de l'upload : ${data.message || 'Inconnue'}`, 'error', 6000);
        }
      } catch (err: any) {
        showToast(`Erreur réseau : ${err.message}`, 'error', 6000);
      } finally {
        if (imageSaveBtn) {
          imageSaveBtn.textContent = "Valider l'image";
          imageSaveBtn.removeAttribute('disabled');
        }
      }
    });

    // Reset des brouillons avec boîte de confirmation moderne
    btnReset?.addEventListener('click', async () => {
      const confirmed = await showConfirm({
        title: 'Annuler les modifications',
        message: 'Voulez-vous annuler toutes les modifications locales en attente ? Les changements non enregistrés seront définitivement perdus.',
        confirmText: 'Oui, tout annuler',
        cancelText: 'Poursuivre les modifications',
        isDanger: true,
      });

      if (confirmed) {
        localStorage.removeItem('campus_cms_drafts');
        showToast('Modifications locales annulées.', 'info', 2000);
        setTimeout(() => {
          window.location.reload();
        }, 300);
      }
    });

    // Enregistrement et mise en ligne des modifications avec confirmation
    btnSave?.addEventListener('click', async () => {
      const drafts = getDrafts();
      const hasDrafts = Object.keys(drafts).length > 0;

      const confirmed = await showConfirm({
        title: 'Enregistrer les modifications',
        message: hasDrafts
          ? 'Voulez-vous enregistrer et mettre en ligne immédiatement les modifications apportées à ce cours ?'
          : 'Voulez-vous synchroniser et actualiser le cours en ligne ?',
        confirmText: 'Enregistrer et publier',
        cancelText: 'Annuler',
        isDanger: false,
      });

      if (!confirmed) return;

      if (btnSave) {
        btnSave.textContent = 'Enregistrement...';
        btnSave.setAttribute('disabled', 'true');
      }

      try {
        // 1. Sauvegarde des brouillons sur les fichiers du serveur
        if (hasDrafts) {
          const saveRes = await fetch('/api/cms/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ drafts }),
          });

          const saveData = await saveRes.json();
          if (!saveData.success) {
            throw new Error(saveData.message || "Erreur lors de l'enregistrement des fichiers.");
          }

          localStorage.removeItem('campus_cms_drafts');
          updateDraftUI();
        }

        // 2. Publication / synchronisation en ligne
        const pubRes = await fetch('/api/cms/publish', { method: 'POST' });
        const pubData = await pubRes.json();

        if (pubData.success) {
          showToast('Modifications enregistrées et mises en ligne avec succès !', 'success', 5000);
          setTimeout(() => {
            window.location.reload();
          }, 1200);
        } else {
          showToast(`Erreur de mise en ligne : ${pubData.message}`, 'error', 6000);
        }
      } catch (err: any) {
        showToast(`Erreur : ${err.message}`, 'error', 6000);
      } finally {
        if (btnSave) {
          btnSave.textContent = 'Enregistrer';
          btnSave.removeAttribute('disabled');
        }
      }
    });

    // Appliquer l'état initial des brouillons
    updateDraftUI();
  }
</script>

