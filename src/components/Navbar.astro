---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/assets/images/brand/Logo_color(rgb).svg" alt="Nakôbio Logo" class="brand-logo" />
      <div class="brand-text">
        <span class="brand-name">Nakôbio</span>
        <span class="brand-sub">Formations Agroécologiques</span>
      </div>
    </a>

    <nav class="nav">
      <a href="/" class:list={['nav-link', { active: currentPath === '/' }]}>Accueil</a>
      <a href="/semences" class:list={['nav-link', { active: currentPath.startsWith('/semences') }]}>Semences Paysannes</a>
      <a href="/maraichage" class:list={['nav-link', { active: currentPath.startsWith('/maraichage') }]}>Maraîchage Sol Vivant</a>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .brand-logo {
    height: 38px;
    width: auto;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-primary-deep);
    line-height: 1.1;
  }

  .brand-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    transition: all 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-primary-deep);
    background-color: var(--color-primary-light);
  }

  .nav-link.active {
    color: var(--color-primary-deep);
    background-color: var(--color-primary-light);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      height: auto;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
      gap: 0.75rem;
    }
  }
</style>
