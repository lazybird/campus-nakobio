---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/assets/images/brand/Logo_color(rgb).svg" alt="Nakôbio Logo" class="brand-logo" />
      <div class="brand-text">
        <div class="brand-top-row">
          <span class="brand-name">Nakôbio</span>
          <span class="brand-badge">Campus</span>
        </div>
        <span class="brand-sub">École & Pratiques Agroécologiques</span>
      </div>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <a href="/" class:list={['nav-link', { active: currentPath === '/' }]}>
        Accueil
      </a>
      <a href="/semences" class:list={['nav-link', { active: currentPath.startsWith('/semences') }]}>
        Semences Paysannes
      </a>
      <a href="/maraichage" class:list={['nav-link', { active: currentPath.startsWith('/maraichage') }]}>
        Maraîchage Sol Vivant
      </a>
      <a href="/pratiques-terrain" class:list={['nav-link', { active: currentPath.startsWith('/pratiques-terrain') }]}>
        Pratiques Terrain
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: rgba(255, 253, 246, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
  }

  .brand-logo {
    height: 42px;
    width: auto;
    transition: transform var(--transition-base);
  }

  .brand:hover .brand-logo {
    transform: scale(1.04);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-top-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .brand-badge {
    display: inline-block;
    padding: 2px 7px;
    background-color: rgba(200, 104, 50, 0.12);
    color: var(--color-brand-secondary);
    border: 1px solid rgba(200, 104, 50, 0.25);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .brand-sub {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--color-ink-faint);
    font-weight: 500;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-sm);
    color: var(--color-ink-soft);
    position: relative;
    transition: all var(--transition-base);
  }

  .nav-link:hover {
    color: var(--color-brand-primary);
    background-color: rgba(47, 74, 52, 0.06);
  }

  .nav-link.active {
    color: var(--color-brand-primary);
    background-color: rgba(47, 74, 52, 0.09);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 20%;
    right: 20%;
    height: 2px;
    background-color: var(--color-brand-secondary);
    border-radius: 2px;
  }

  @media (max-width: 820px) {
    .header-inner {
      flex-direction: column;
      height: auto;
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
      gap: 0.85rem;
    }

    .nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.3rem;
    }

    .nav-link {
      font-size: 0.82rem;
      padding: 0.4rem 0.65rem;
    }
  }
</style>
